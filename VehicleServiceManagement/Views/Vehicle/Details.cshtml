@model VehicleServiceManagement.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<h2>Vehicle Details</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Vehicle Number
            </dt>

            <dd class="col-sm-9">
                @Model.VehicleNumber
            </dd>

            <dt class="col-sm-3">
                Vehicle Model
            </dt>

            <dd class="col-sm-9">
                @Model.VehicleModel
            </dd>

            <dt class="col-sm-3">
                Vehicle Type
            </dt>

            <dd class="col-sm-9">
                @Model.VehicleType
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>
@model IEnumerable<VehicleServiceManagement.Models.Vehicle>

@{
    ViewData["Title"] = "My Vehicles";
}

<div class="py-3">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Garage</h2>
            <p class="text-muted small mb-0">Register and manage your fleet of personal or commercial vehicles.</p>
        </div>

        <a asp-action="Create" class="btn btn-success btn-sm shadow-sm">
            <i class="bi bi-plus-lg"></i> Register New Vehicle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <div class="feature-icon-wrapper icon-primary mx-auto mb-3" style="width:64px; height:64px; font-size: 2rem;">
                <i class="bi bi-car-front"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">No Vehicles Registered</h5>
            <p class="text-muted small mb-4">Add your car, motorbike, or van to start booking repair and maintenance requests.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-plus-lg"></i> Add Your First Vehicle
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive border-0">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Vehicle Number / Plate</th>
                            <th>Model & Specification</th>
                            <th>Vehicle Category</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vehicle in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="brand-icon" style="width:34px; height:34px; font-size:1rem; border-radius: 8px;">
                                            <i class="bi bi-car-front-fill"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@vehicle.VehicleNumber</span>
                                            <span class="text-muted small">ID: #@vehicle.Id</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@vehicle.VehicleModel</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-tag-fill me-1"></i> @vehicle.VehicleType
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@vehicle.Id" class="btn btn-outline-primary" title="Edit Vehicle">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@vehicle.Id" class="btn btn-outline-danger" title="Remove Vehicle">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
@model VehicleServiceManagement.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<h2>Add Vehicle</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            ```
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="VehicleNumber"
                       class="form-label">
                </label>

                <input asp-for="VehicleNumber"
                       class="form-control" />

                <span asp-validation-for="VehicleNumber"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Make"
                       class="form-label">
                </label>

                <input asp-for="Make"
                       class="form-control" />

                <span asp-validation-for="Make"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Model"
                       class="form-label">
                </label>

                <input asp-for="Model"
                       class="form-control" />

                <span asp-validation-for="Model"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Year"
                       class="form-label">
                </label>

                <input asp-for="Year"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="Year"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Add Vehicle
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
    ```

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model VehicleServiceManagement.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h2>Delete Vehicle</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this vehicle?
</div>

<div class="card">
    <div class="card-body">
        <h5>@Model.VehicleNumber</h5>

        ```
        <p>
            <strong>Make:</strong> @Model.Make
        </p>

        <p>
            <strong>Model:</strong> @Model.Model
        </p>

        <p>
            <strong>Year:</strong> @Model.Year
        </p>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger">
                Yes, Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
    ```

</div>

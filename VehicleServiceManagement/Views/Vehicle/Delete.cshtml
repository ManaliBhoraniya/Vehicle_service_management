@model VehicleServiceManagement.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-6">
        <div class="card border-danger border-opacity-25 shadow-sm">
            <div class="card-header bg-danger-subtle bg-opacity-25 py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <h5 class="fw-bold text-danger mb-0">Confirm Vehicle Deletion</h5>
                </div>
            </div>

            <div class="card-body p-4">
                <p class="text-muted">
                    Are you sure you want to permanently remove this vehicle from your account? Any pending service requests associated with this vehicle may be affected.
                </p>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Vehicle Number:</span>
                            <strong class="text-dark">@Model.VehicleNumber</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Model:</span>
                            <strong class="text-dark">@Model.VehicleModel</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Type:</span>
                            <span class="badge bg-secondary">@Model.VehicleType</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash"></i> Yes, Delete Vehicle
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
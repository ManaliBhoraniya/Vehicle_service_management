@{
    ViewData["Title"] = "Access Restricted";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-lg text-center p-5">
            <div class="feature-icon-wrapper icon-danger mx-auto mb-4" style="width: 72px; height: 72px; font-size: 2.2rem; border-radius: 50%;">
                <i class="bi bi-shield-x"></i>
            </div>

            <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not possess the required authorization or role to view this protected resource.
            </p>

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-house"></i> Go to Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In Again
                </a>
            </div>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header text-center">

                    <h2>
                        Create Account
                    </h2>

                </div>


                <div class="card-body">

                    <form asp-action="Register"
                          asp-controller="Account"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()


                        <!-- VALIDATION -->

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>


                        <!-- ================================================= -->
                        <!-- NAME -->
                        <!-- ================================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Name
                            </label>

                            <input type="text"
                                   name="name"
                                   class="form-control"
                                   placeholder="Enter your name"
                                   required />

                        </div>


                        <!-- ================================================= -->
                        <!-- EMAIL -->
                        <!-- ================================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   name="email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   required />

                        </div>


                        <!-- ================================================= -->
                        <!-- ROLE -->
                        <!-- ================================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Register As
                            </label>

                            <select name="role"
                                    id="role"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Role --
                                </option>

                                <option value="Customer">
                                    Customer
                                </option>

                                <option value="Worker">
                                    Worker
                                </option>

                            </select>

                            <small class="text-muted">
                                Manager accounts are created by the system.
                            </small>

                        </div>


                        <!-- ================================================= -->
                        <!-- WORKER ONLY FIELDS -->
                        <!-- ================================================= -->

                        <div id="workerFields"
                             style="display:none;">


                            <!-- ================================================= -->
                            <!-- SPECIALITIES -->
                            <!-- ================================================= -->

                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    Select Your Specialities
                                </label>

                                <p class="text-muted small">
                                    Select all services that you are
                                    qualified to perform.
                                </p>


                                <div id="specialityContainer"
                                     class="border rounded p-3">


                                    <!-- ENGINE REPAIR -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input speciality-checkbox"
                                               type="checkbox"
                                               name="specialities"
                                               value="Engine Repair"
                                               id="engineRepair" />

                                        <label class="form-check-label"
                                               for="engineRepair">

                                            Engine Repair

                                        </label>

                                    </div>


                                    <!-- BRAKE REPAIR -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input speciality-checkbox"
                                               type="checkbox"
                                               name="specialities"
                                               value="Brake Repair"
                                               id="brakeRepair" />

                                        <label class="form-check-label"
                                               for="brakeRepair">

                                            Brake Repair

                                        </label>

                                    </div>


                                    <!-- OIL CHANGE -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input speciality-checkbox"
                                               type="checkbox"
                                               name="specialities"
                                               value="Oil Change"
                                               id="oilChange" />

                                        <label class="form-check-label"
                                               for="oilChange">

                                            Oil Change

                                        </label>

                                    </div>


                                    <!-- AC REPAIR -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input speciality-checkbox"
                                               type="checkbox"
                                               name="specialities"
                                               value="AC Repair"
                                               id="acRepair" />

                                        <label class="form-check-label"
                                               for="acRepair">

                                            AC Repair

                                        </label>

                                    </div>


                                    <!-- ELECTRICAL REPAIR -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input speciality-checkbox"
                                               type="checkbox"
                                               name="specialities"
                                               value="Electrical Repair"
                                               id="electricalRepair" />

                                        <label class="form-check-label"
                                               for="electricalRepair">

                                            Electrical Repair

                                        </label>

                                    </div>


                                    <!-- TIRE & WHEEL SERVICE -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input speciality-checkbox"
                                               type="checkbox"
                                               name="specialities"
                                               value="Tire & Wheel Service"
                                               id="tireWheelService" />

                                        <label class="form-check-label"
                                               for="tireWheelService">

                                            Tire &amp; Wheel Service

                                        </label>

                                    </div>


                                    <!-- TRANSMISSION REPAIR -->

                                    <div class="form-check mb-2">

                                        <input class="form-check-input speciality-checkbox"
                                               type="checkbox"
                                               name="specialities"
                                               value="Transmission Repair"
                                               id="transmissionRepair" />

                                        <label class="form-check-label"
                                               for="transmissionRepair">

                                            Transmission Repair

                                        </label>

                                    </div>


                                    <!-- GENERAL SERVICE -->

                                    <div class="form-check">

                                        <input class="form-check-input speciality-checkbox"
                                               type="checkbox"
                                               name="specialities"
                                               value="General Service"
                                               id="generalService" />

                                        <label class="form-check-label"
                                               for="generalService">

                                            General Service

                                        </label>

                                    </div>

                                </div>


                                <div id="specialityError"
                                     class="text-danger mt-2"
                                     style="display:none;">

                                    Please select at least one speciality.

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- RESUME -->
                            <!-- ================================================= -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Resume
                                </label>

                                <input type="file"
                                       name="resume"
                                       id="resume"
                                       class="form-control"
                                       accept=".pdf,.doc,.docx" />

                                <small class="text-muted">
                                    PDF, DOC or DOCX. Maximum 5 MB.
                                </small>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- PASSWORD -->
                        <!-- ================================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Password
                            </label>

                            <input type="password"
                                   name="password"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   required />

                            <small class="text-muted">

                                Minimum 6 characters with uppercase,
                                lowercase, number and special character.

                            </small>

                        </div>


                        <!-- ================================================= -->
                        <!-- CONFIRM PASSWORD -->
                        <!-- ================================================= -->

                        <div class="mb-3">

                            <label class="form-label">
                                Confirm Password
                            </label>

                            <input type="password"
                                   name="confirmPassword"
                                   class="form-control"
                                   placeholder="Confirm your password"
                                   required />

                        </div>


                        <!-- ================================================= -->
                        <!-- REGISTER -->
                        <!-- ================================================= -->

                        <button type="submit"
                                class="btn btn-success w-100">

                            Register

                        </button>

                    </form>


                    <!-- ================================================= -->
                    <!-- LOGIN -->
                    <!-- ================================================= -->

                    <div class="text-center mt-4">

                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="Login">

                            Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        function updateWorkerFields() {

            const role =
                document.getElementById("role").value;


            const workerFields =
                document.getElementById(
                    "workerFields"
                );


            const resume =
                document.getElementById(
                    "resume"
                );


            const specialityCheckboxes =
                document.querySelectorAll(
                    ".speciality-checkbox"
                );


            if (role === "Worker") {

                // Show worker fields

                workerFields.style.display =
                    "block";


                // Resume required

                resume.required =
                    true;

            }
            else {

                // Hide worker fields

                workerFields.style.display =
                    "none";


                // Resume not required

                resume.required =
                    false;


                // Clear resume

                resume.value =
                    "";


                // Clear speciality selections

                specialityCheckboxes.forEach(
                    checkbox => {

                        checkbox.checked =
                            false;

                    }
                );


                document.getElementById(
                    "specialityError"
                ).style.display =
                    "none";
            }
        }


        // =====================================================
        // VALIDATE SPECIALITY
        // =====================================================

        document.querySelector("form")
            .addEventListener(
                "submit",
                function (event) {

                    const role =
                        document.getElementById(
                            "role"
                        ).value;


                    if (role !== "Worker") {

                        return;
                    }


                    const checkboxes =
                        document.querySelectorAll(
                            ".speciality-checkbox:checked"
                        );


                    const error =
                        document.getElementById(
                            "specialityError"
                        );


                    if (checkboxes.length === 0) {

                        event.preventDefault();


                        error.style.display =
                            "block";


                        error.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                    }
                    else {

                        error.style.display =
                            "none";

                    }

                }
            );


        // =====================================================
        // ROLE CHANGE
        // =====================================================

        document.getElementById("role")
            .addEventListener(
                "change",
                updateWorkerFields
            );


        // =====================================================
        // INITIAL PAGE LOAD
        // =====================================================

        updateWorkerFields();

    </script>
}
@model VehicleServiceManagement.Models.ServiceRequest

@{
    ViewData["Title"] = "Service Request Details";

    var cust = Model.Vehicle?.Customer ?? Model.Customer;
    var custDisplayName = cust?.Name;
    if (string.IsNullOrWhiteSpace(custDisplayName))
    {
        custDisplayName = cust?.ApplicationUser?.Name;
    }
    if (string.IsNullOrWhiteSpace(custDisplayName))
    {
        custDisplayName = Model.CustomerName;
    }
    var finalCustomerName = string.IsNullOrWhiteSpace(custDisplayName) ? "N/A" : custDisplayName;
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Service Request #@Model.Id</h5>
                        <span class="text-muted small">Created on @Model.RequestDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                    </div>
                </div>

                <div>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-warning-emphasis px-3 py-2">
                            <i class="bi bi-hourglass-split"></i> Pending Assignment
                        </span>
                    }
                    else if (Model.Status == "Assigned")
                    {
                        <span class="badge bg-primary text-primary-emphasis px-3 py-2">
                            <i class="bi bi-person-gear"></i> Assigned to Technician
                        </span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="badge bg-success text-success-emphasis px-3 py-2">
                            <i class="bi bi-check2-circle"></i> Service Completed
                        </span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-danger text-danger-emphasis px-3 py-2">
                            <i class="bi bi-x-circle"></i> Request Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2">@Model.Status</span>
                    }
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">
                    <!-- CUSTOMER & SERVICE INFO -->
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Customer Name</label>
                        <span class="fs-6 fw-bold text-dark">
                            <i class="bi bi-person me-1 text-muted"></i> @finalCustomerName
                        </span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Requested Service</label>
                        <span class="fs-6 fw-bold text-primary">
                            <i class="bi bi-tools me-1"></i> @Model.ServiceType
                        </span>
                    </div>

                    <!-- VEHICLE INFO -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-car-front-fill text-primary"></i>
                                <span class="fw-bold text-dark">Vehicle Information</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-sm-4">
                                    <span class="text-muted small d-block">Plate Number:</span>
                                    <span class="fw-semibold text-dark">@(Model.Vehicle?.VehicleNumber ?? "N/A")</span>
                                </div>
                                <div class="col-sm-4">
                                    <span class="text-muted small d-block">Make / Model:</span>
                                    <span class="fw-semibold text-dark">@(Model.Vehicle?.VehicleModel ?? "N/A")</span>
                                </div>
                                <div class="col-sm-4">
                                    <span class="text-muted small d-block">Type:</span>
                                    <span class="badge bg-secondary">@(Model.Vehicle?.VehicleType ?? "N/A")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- DESCRIPTION -->
                    <div class="col-12">
                        <label class="text-muted small d-block">Problem Symptoms & Customer Notes</label>
                        <div class="p-3 bg-white border rounded-3 mt-1 text-dark">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No special remarks provided." : Model.Description)
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                    @if (User.IsInRole("Customer") && Model.Status != "Completed" && Model.Status != "Cancelled")
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to cancel this request?');">
                                <i class="bi bi-x-circle"></i> Cancel Request
                            </button>
                        </form>
                    }

                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to Requests
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
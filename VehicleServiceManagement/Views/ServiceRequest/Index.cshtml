@model IEnumerable<VehicleServiceManagement.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="py-3">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Service Requests</h2>
            <p class="text-muted small mb-0">Track maintenance appointments, diagnostic tickets, and completion updates.</p>
        </div>

        @if (User.IsInRole("Customer"))
        {
            <a asp-action="Create" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-clipboard-plus"></i> New Service Request
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <div class="feature-icon-wrapper icon-info mx-auto mb-3" style="width:64px; height:64px; font-size: 2rem;">
                <i class="bi bi-card-checklist"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">No Service Requests Found</h5>
            <p class="text-muted small mb-4">No maintenance tickets have been submitted yet.</p>
            @if (User.IsInRole("Customer"))
            {
                <div>
                    <a asp-action="Create" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-plus-lg"></i> Book Service Now
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive border-0">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Vehicle</th>
                            <th>Service Category</th>
                            <th>Requested On</th>
                            <th>Current Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-primary">#@request.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="brand-icon" style="width:30px; height:30px; font-size:0.85rem; border-radius:6px;">
                                            <i class="bi bi-car-front-fill"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@(request.Vehicle?.VehicleNumber ?? "N/A")</span>
                                            <span class="text-muted small">@(request.Vehicle?.VehicleModel ?? "")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@request.ServiceType</span>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        <i class="bi bi-calendar3 me-1"></i> @request.RequestDate.ToString("dd MMM yyyy, HH:mm")
                                    </span>
                                </td>
                                <td>
                                    @if (request.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-warning-emphasis">
                                            <i class="bi bi-hourglass-split"></i> Pending
                                        </span>
                                    }
                                    else if (request.Status == "Assigned")
                                    {
                                        <span class="badge bg-primary text-primary-emphasis">
                                            <i class="bi bi-person-gear"></i> Assigned
                                        </span>
                                    }
                                    else if (request.Status == "Completed")
                                    {
                                        <span class="badge bg-success text-success-emphasis">
                                            <i class="bi bi-check2-circle"></i> Completed
                                        </span>
                                    }
                                    else if (request.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger text-danger-emphasis">
                                            <i class="bi bi-x-circle"></i> Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@request.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="Delete" asp-route-id="@request.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this request?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Request">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (User.IsInRole("Customer") && request.Status != "Completed" && request.Status != "Cancelled")
                                        {
                                            <form asp-action="Cancel" asp-route-id="@request.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this request?');">
                                                    Cancel
                                                </button>
                                            </form>
                                        }

                                        @if (User.IsInRole("Admin") || User.IsInRole("Worker"))
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline-flex gap-1 ms-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@request.Id" />
                                                <select name="status" class="form-select form-select-sm" style="width: 125px;">
                                                    <option value="Pending" selected="@(request.Status == "Pending")">Pending</option>
                                                    <option value="Assigned" selected="@(request.Status == "Assigned")">Assigned</option>
                                                    <option value="Completed" selected="@(request.Status == "Completed")">Completed</option>
                                                    <option value="Cancelled" selected="@(request.Status == "Cancelled")">Cancelled</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    Set
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
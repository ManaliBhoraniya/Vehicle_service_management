@model VehicleServiceManagement.Models.ServiceRequest

@{
    ViewData["Title"] = "Create Service Request";

    var vehicles =
        ViewBag.Vehicles as IEnumerable<VehicleServiceManagement.Models.Vehicle>;
}

<div class="container mt-4">

    <h2 class="mb-4">
        Create Service Request
    </h2>

    <div class="row">

        <!-- SERVICE REQUEST FORM -->

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">
                        New Service Request
                    </h5>
                </div>

                <div class="card-body">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- VEHICLE -->

                        <div class="mb-3">

                            <label asp-for="VehicleId"
                                   class="form-label">
                                Select Vehicle
                            </label>

                            <select asp-for="VehicleId"
                                    class="form-select">

                                <option value="">
                                    -- Select Vehicle --
                                </option>

                                @if (vehicles != null)
                                {
                                    foreach (var vehicle in vehicles)
                                    {
                                        <option value="@vehicle.Id">
                                            @vehicle.VehicleNumber -
                                            @vehicle.VehicleModel
                                        </option>
                                    }
                                }

                            </select>

                            <span asp-validation-for="VehicleId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- SERVICE TYPE -->

                        <div class="mb-3">

                            <label asp-for="ServiceType"
                                   class="form-label">
                                Service Type
                            </label>

                            <select asp-for="ServiceType"
                                    class="form-select">

                                <option value="">
                                    -- Select Service Type --
                                </option>

                                <option value="General Service">
                                    General Service
                                </option>

                                <option value="Brake Repair">
                                    Brake Repair / Brake Problem
                                </option>

                                <option value="Engine Repair">
                                    Engine Repair / Engine Problem
                                </option>

                                <option value="Oil Change">
                                    Oil Change
                                </option>

                                <option value="AC Repair">
                                    AC Repair / AC Problem
                                </option>

                                <option value="Electrical Repair">
                                    Electrical Repair / Problem
                                </option>

                                <option value="Tire & Wheel Service">
                                    Tire &amp; Wheel Service / Tyre Problem
                                </option>

                                <option value="Transmission Repair">
                                    Transmission Repair
                                </option>

                                <option value="Battery Problem">
                                    Battery Problem
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                            <span asp-validation-for="ServiceType"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PROBLEM DESCRIPTION -->

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Describe the Problem
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Please describe the problem with your vehicle..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Please provide details about the
                                problem so the service manager and
                                worker can understand the issue.
                            </small>

                        </div>


                        <!-- BUTTONS -->

                        <div class="mt-4">

                            <button type="submit"
                                    class="btn btn-success">
                                Submit Service Request
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        <!-- INFORMATION -->

        <div class="col-md-5">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h5 class="mb-3">
                        Service Request Information
                    </h5>

                    <p class="text-muted mb-2">
                        Select your vehicle, choose the required
                        service, and describe the problem clearly.
                    </p>

                    <p class="text-muted mb-0">
                        Your request will be submitted with
                        <strong>Pending</strong> status and reviewed
                        by the service team.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
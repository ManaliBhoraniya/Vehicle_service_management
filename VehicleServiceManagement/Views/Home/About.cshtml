@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">About Us</h1>
        <p class="text-muted">
            Vehicle Service Management System
        </p>
    </div>

    <!-- About Section -->
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    <h3 class="fw-bold mb-3">
                        Vehicle Service Management
                    </h3>

                    <p class="text-muted">
                        Vehicle Service Management is a web-based system
                        designed to make vehicle servicing easier and more
                        organized for customers, workers, and service managers.
                    </p>

                    <p class="text-muted">
                        Customers can manage their vehicles, submit service
                        requests, and track their service information.
                        Workers can manage their availability, view assigned
                        services, and update the progress of their work.
                    </p>

                    <p class="text-muted">
                        The system also helps service managers organize
                        service requests, assign work to workers, and manage
                        the overall vehicle service process.
                    </p>

                    <hr class="my-4" />

                    <h4 class="fw-bold mb-3">
                        What We Provide
                    </h4>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h5 class="text-primary">
                                    Vehicle Management
                                </h5>
                                <p class="text-muted mb-0">
                                    Manage vehicle details and keep service
                                    information organized.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h5 class="text-success">
                                    Service Requests
                                </h5>
                                <p class="text-muted mb-0">
                                    Customers can submit service requests
                                    and follow their service progress.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <h5 class="text-warning">
                                    Worker Management
                                </h5>
                                <p class="text-muted mb-0">
                                    Workers can manage availability and
                                    handle assigned service requests.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>

</div>
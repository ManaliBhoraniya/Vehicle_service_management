@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">
            Privacy Policy
        </h1>

        <p class="text-muted">
            Vehicle Service Management
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

            <h4 class="fw-bold">
                Information We Collect
            </h4>

            <p class="text-muted">
                The system may store information required to manage
                customer accounts, vehicles, service requests, and
                worker information.
            </p>

            <h4 class="fw-bold mt-4">
                Use of Information
            </h4>

            <p class="text-muted">
                Information is used to provide vehicle service management
                functionality and to maintain service records.
            </p>

            <h4 class="fw-bold mt-4">
                Account Security
            </h4>

            <p class="text-muted">
                Users should keep their login credentials private and
                secure.
            </p>

            <h4 class="fw-bold mt-4">
                Contact
            </h4>

            <p class="text-muted mb-0">
                If you have questions about this system, please use the
                Contact Us page.
            </p>

        </div>
    </div>

</div>
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="py-4">
    <div class="text-center mb-5">
        <span class="badge bg-secondary px-3 py-2 mb-2">Legal Information</span>
        <h1 class="fw-bold">Privacy Policy</h1>
        <p class="text-muted">How AutoCare Pro handles and protects your vehicle and personal information.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <section class="mb-4">
                        <h4 class="fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-primary"></i> 1. Information We Collect
                        </h4>
                        <p class="text-muted">
                            AutoCare Pro stores personal and technical information strictly necessary to provide vehicle service management functionality:
                        </p>
                        <ul class="text-muted">
                            <li>Account details (name, email address, contact numbers, user roles).</li>
                            <li>Vehicle identifiers (make, model, registration number, service logs).</li>
                            <li>Service requests, technician task logs, and maintenance timelines.</li>
                        </ul>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-gear-fill text-success"></i> 2. How We Use Information
                        </h4>
                        <p class="text-muted">
                            We utilize stored data to optimize your maintenance schedules, communicate diagnostics, allocate certified mechanics to service requests, and preserve audit histories for vehicle safety records.
                        </p>
                    </section>

                    <section class="mb-4">
                        <h4 class="fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-lock-fill text-warning"></i> 3. Security & Account Integrity
                        </h4>
                        <p class="text-muted">
                            Passwords are cryptographically hashed and never stored in plain text. We utilize role-based access control to prevent unauthorized modification of customer or service tickets.
                        </p>
                    </section>

                    <section>
                        <h4 class="fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-info"></i> 4. Contact Our Data Protection Team
                        </h4>
                        <p class="text-muted mb-0">
                            For any inquiries regarding data protection or record updates, please submit a request via our <a asp-controller="Home" asp-action="Contact">Contact Page</a>.
                        </p>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>
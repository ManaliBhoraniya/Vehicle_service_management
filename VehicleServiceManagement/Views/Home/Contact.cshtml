@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold text-primary">Contact Us</h1>

        <p class="text-muted">
            Get in touch with our Vehicle Service Management team.
        </p>
    </div>


    <div class="row justify-content-center g-4">

        <!-- Address -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 text-center">

                    <h4 class="fw-bold text-primary mb-3">
                        Address
                    </h4>

                    <p class="text-muted mb-0">
                        Vehicle Service Management Center
                        <br />
                        Gujarat, India
                    </p>

                </div>
            </div>

        </div>


        <!-- Phone -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 text-center">

                    <h4 class="fw-bold text-success mb-3">
                        Phone
                    </h4>

                    <p class="text-muted mb-0">
                        +91 98765 43210
                    </p>

                </div>
            </div>

        </div>


        <!-- Email -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4 text-center">

                    <h4 class="fw-bold text-warning mb-3">
                        Email
                    </h4>

                    <p class="text-muted mb-0">
                        support@vehicleservice.com
                    </p>

                </div>
            </div>

        </div>

    </div>


    <!-- Working Hours -->

    <div class="row justify-content-center mt-4">

        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center">

                    <h4 class="fw-bold text-danger mb-3">
                        Working Hours
                    </h4>

                    <p class="text-muted mb-1">
                        Monday - Saturday
                    </p>

                    <p class="text-muted mb-0">
                        9:00 AM - 6:00 PM
                    </p>

                </div>
            </div>

        </div>

    </div>


    <!-- Additional Information -->

    <div class="text-center mt-5">

        <h4 class="fw-bold">
            Vehicle Service Management
        </h4>

        <p class="text-muted">
            For vehicle service information, service requests,
            worker assistance, or account-related support,
            please contact us using the details provided above.
        </p>

    </div>

</div>
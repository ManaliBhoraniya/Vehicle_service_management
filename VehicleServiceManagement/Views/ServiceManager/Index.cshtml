@{
    ViewData["Title"] = "Service Manager Dashboard";
}

<h2 class="mb-4">Service Manager Dashboard</h2>

<div class="row g-4">

    <!-- CUSTOMERS -->

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">

                <h6>Customers</h6>

                <h2>
                    @ViewBag.CustomerCount
                </h2>

                <a asp-action="Customers"
                   class="btn btn-outline-primary btn-sm">
                    View Customers
                </a>

            </div>
        </div>
    </div>


    <!-- VEHICLES -->

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">

                <h6>Vehicles</h6>

                <h2>
                    @ViewBag.VehicleCount
                </h2>

                <a asp-action="Vehicles"
                   class="btn btn-outline-primary btn-sm">
                    View Vehicles
                </a>

            </div>
        </div>
    </div>


    <!-- WORKERS -->

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">

                <h6>Workers</h6>

                <h2>
                    @ViewBag.WorkerCount
                </h2>

                <a asp-action="Workers"
                   class="btn btn-outline-primary btn-sm">
                    View Workers
                </a>

            </div>
        </div>
    </div>


    <!-- SERVICE REQUESTS -->

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">

                <h6>Service Requests</h6>

                <h2>
                    @ViewBag.ServiceRequestCount
                </h2>

                <a asp-action="ServiceRequests"
                   class="btn btn-outline-primary btn-sm">
                    View Requests
                </a>

            </div>
        </div>
    </div>

</div>


<!-- ================================================= -->
<!-- SERVICE REQUEST STATUS -->
<!-- ================================================= -->

<div class="row g-4 mt-2">

    <!-- PENDING -->

    <div class="col-md-4">
        <div class="card border-warning shadow-sm">
            <div class="card-body text-center">

                <h5>Pending Requests</h5>

                <h2>
                    @ViewBag.PendingRequests
                </h2>

            </div>
        </div>
    </div>


    <!-- ASSIGNED -->

    <div class="col-md-4">
        <div class="card border-primary shadow-sm">
            <div class="card-body text-center">

                <h5>Assigned Requests</h5>

                <h2>
                    @ViewBag.AssignedRequests
                </h2>

            </div>
        </div>
    </div>


    <!-- COMPLETED -->

    <div class="col-md-4">
        <div class="card border-success shadow-sm">
            <div class="card-body text-center">

                <h5>Completed Requests</h5>

                <h2>
                    @ViewBag.CompletedRequests
                </h2>

            </div>
        </div>
    </div>

</div>


<!-- ================================================= -->
<!-- WORKER JOB REQUESTS -->
<!-- ================================================= -->

<div class="row g-4 mt-2">

    <div class="col-md-12">

        <div class="card border-warning shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="mb-1">
                            Worker Job Requests
                        </h5>

                        <p class="text-muted mb-0">
                            New worker applications waiting for review.
                        </p>

                    </div>

                    <div class="text-center">

                        <h2 class="mb-2">
                            @ViewBag.PendingJobRequests
                        </h2>

                        <a asp-action="JobRequests"
                           class="btn btn-warning">

                            View Job Requests

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ================================================= -->
<!-- MANAGER ACTIONS -->
<!-- ================================================= -->

<div class="mt-4">

    <a asp-action="Assignments"
       class="btn btn-primary">

        Manage Assignments

    </a>


    <a asp-action="JobRequests"
       class="btn btn-warning">

        Job Requests

    </a>

</div>
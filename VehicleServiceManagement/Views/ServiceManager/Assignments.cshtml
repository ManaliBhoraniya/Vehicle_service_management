@model IEnumerable<VehicleServiceManagement.Models.ServiceAssignment>

@{
ViewData["Title"] = "Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Service Assignments</h2>

```
<a asp-controller="ServiceAssignment"
   asp-action="Create"
   class="btn btn-success">
    Create Assignment
</a>
```

</div>

@if (!Model.Any())
{ <div class="alert alert-info">
No assignments found. </div>
}
else
{ <div class="table-responsive"> <table class="table table-bordered table-hover">

```
        <thead class="table-dark">
            <tr>
                <th>Assignment ID</th>
                <th>Request ID</th>
                <th>Vehicle</th>
                <th>Worker</th>
                <th>Assigned Date</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var assignment in Model)
            {
                <tr>
                    <td>@assignment.Id</td>

                    <td>
                        #@assignment.ServiceRequestId
                    </td>

                    <td>
                        @assignment.ServiceRequest?.Vehicle?.VehicleNumber
                    </td>

                    <td>
                        @assignment.Worker?.User?.UserName
                    </td>

                    <td>
                        @assignment.AssignedDate.ToString(
                            "dd-MM-yyyy HH:mm")
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
```

}

<a asp-action="Index"
class="btn btn-secondary">
Back to Dashboard </a>

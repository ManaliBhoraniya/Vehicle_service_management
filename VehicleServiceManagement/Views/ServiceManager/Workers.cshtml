@model IEnumerable<VehicleServiceManagement.Models.Worker>

@{
    ViewData["Title"] = "Workers";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Workers</h2>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">

            No workers found.

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>

                        <th>ID</th>

                        <th>Name</th>

                        <th>Username</th>

                        <th>Email</th>

                        <th>Specialities</th>

                        <th>Available</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var worker in Model)
                    {
                        <tr>

                            <td>
                                @worker.WorkerId
                            </td>

                            <td>
                                @worker.ApplicationUser?.Name
                            </td>

                            <td>
                                @worker.ApplicationUser?.UserName
                            </td>

                            <td>
                                @worker.ApplicationUser?.Email
                            </td>

                            <td>

                                @if (worker.Specialities != null &&
                                    worker.Specialities.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">

                                        @foreach (
                                            var speciality
                                            in worker.Specialities)
                                        {
                                            <span class="badge bg-primary">
                                                @speciality.Speciality
                                            </span>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No specialities
                                    </span>
                                }

                            </td>

                            <td>

                                @if (worker.IsAvailable)
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Unavailable
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-controller="Worker"
                                   asp-action="Details"
                                   asp-route-id="@worker.WorkerId"
                                   class="btn btn-sm btn-info">

                                    Details

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
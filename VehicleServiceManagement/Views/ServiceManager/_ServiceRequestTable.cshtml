@model IEnumerable<VehicleServiceManagement.Models.ServiceRequest>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-light border text-center py-4 text-muted">
        No service requests found in this section.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 60px;">ID</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Service Required</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Worker Task</th>
                    <th style="width: 100px;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>
                            @request.ServiceRequestId
                        </td>

                        <td>
                            @{
                                var cust = request.Vehicle?.Customer ?? request.Customer;
                                var custDisplayName = cust?.Name;
                                if (string.IsNullOrWhiteSpace(custDisplayName))
                                {
                                    custDisplayName = cust?.ApplicationUser?.Name;
                                }
                                if (string.IsNullOrWhiteSpace(custDisplayName))
                                {
                                    custDisplayName = request.CustomerName;
                                }
                            }
                            @(string.IsNullOrWhiteSpace(custDisplayName) ? "N/A" : custDisplayName)
                        </td>

                        <td>
                            @(request.Vehicle?.VehicleNumber ?? "N/A")
                        </td>

                        <td>
                            <strong>
                                @Html.Raw((request.ServiceType ?? "").Replace("&amp;", "&"))
                            </strong>

                            @if (!string.IsNullOrWhiteSpace(request.Description))
                            {
                                <br />
                                <small class="text-muted">
                                    @request.Description
                                </small>
                            }
                        </td>

                        <td>
                            @request.RequestDate.ToString("dd-MM-yyyy HH:mm")
                        </td>

                        <td>
                            @if (request.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else if (request.Status == "Assigned")
                            {
                                var activeAssignment = request.ServiceAssignments?
                                    .OrderByDescending(a => a.AssignedDate)
                                    .FirstOrDefault(a => a.Status == "Accepted" || a.Status == "Pending" || a.Status == "In Progress");

                                @if (activeAssignment?.Status == "Pending")
                                {
                                    <span class="badge bg-info text-dark">
                                        Assigned (Pending Response)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        In Progress
                                    </span>
                                }
                            }
                            else if (request.Status == "Rejected")
                            {
                                <span class="badge bg-danger">
                                    Worker Rejected
                                </span>
                            }
                            else if (request.Status == "In Progress")
                            {
                                <span class="badge bg-primary">
                                    In Progress
                                </span>
                            }
                            else if (request.Status == "Completed")
                            {
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            }
                            else if (request.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">
                                    Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @request.Status
                                </span>
                            }
                        </td>

                        <td>
                            @if (request.Status == "Pending")
                            {
                                <a asp-controller="ServiceManager"
                                   asp-action="AssignWorker"
                                   asp-route-id="@request.ServiceRequestId"
                                   class="btn btn-success btn-sm">
                                    Assign Worker
                                </a>
                            }
                            else if (request.Status == "Assigned" || request.Status == "In Progress")
                            {
                                var activeAssignment = request.ServiceAssignments?
                                    .OrderByDescending(a => a.AssignedDate)
                                    .FirstOrDefault(a => a.Status == "Accepted" || a.Status == "Pending" || a.Status == "In Progress");

                                @if (activeAssignment?.Status == "Pending")
                                {
                                    <span class="badge bg-info text-dark mb-1">
                                        Waiting for Response
                                    </span>
                                    @if (activeAssignment.Worker?.ApplicationUser != null)
                                    {
                                        <div class="small text-muted">
                                            Sent to: <strong>@activeAssignment.Worker.ApplicationUser.Name</strong>
                                        </div>
                                    }
                                    <a asp-controller="ServiceManager"
                                       asp-action="AssignWorker"
                                       asp-route-id="@request.ServiceRequestId"
                                       class="btn btn-outline-secondary btn-sm mt-1">
                                        Reassign
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-primary mb-1">
                                        Worker Accepted
                                    </span>
                                    @if (activeAssignment?.Worker?.ApplicationUser != null)
                                    {
                                        <div class="small text-muted">
                                            Worker: <strong>@activeAssignment.Worker.ApplicationUser.Name</strong>
                                        </div>
                                    }
                                }
                            }
                            else if (request.Status == "Rejected")
                            {
                                var rejectedAssignment = request.ServiceAssignments?
                                    .OrderByDescending(a => a.AssignedDate)
                                    .FirstOrDefault(a => a.Status == "Rejected");

                                <div class="text-danger small mb-1">
                                    <strong>@(rejectedAssignment?.Worker?.ApplicationUser?.Name ?? "Worker")</strong> rejected request
                                </div>

                                <a asp-controller="ServiceManager"
                                   asp-action="AssignWorker"
                                   asp-route-id="@request.ServiceRequestId"
                                   class="btn btn-warning btn-sm">
                                    Assign Another Worker
                                </a>
                            }
                            else if (request.Status == "Completed")
                            {
                                var compAssignment = request.ServiceAssignments?
                                    .OrderByDescending(a => a.CompletedDate ?? a.AssignedDate)
                                    .FirstOrDefault(a => a.Status == "Completed");

                                <span class="badge bg-success mb-1">
                                    Task Completed
                                </span>
                                @if (compAssignment?.Worker?.ApplicationUser != null)
                                {
                                    <div class="small text-muted">
                                        Worker: <strong>@compAssignment.Worker.ApplicationUser.Name</strong>
                                    </div>
                                }
                            }
                            else if (request.Status == "Cancelled")
                            {
                                <span class="text-muted">
                                    Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @request.Status
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            <form asp-controller="ServiceManager"
                                  asp-action="DeleteRequest"
                                  asp-route-id="@request.ServiceRequestId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete Service Request #@request.ServiceRequestId? This action cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm"
                                        title="Delete Service Request">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

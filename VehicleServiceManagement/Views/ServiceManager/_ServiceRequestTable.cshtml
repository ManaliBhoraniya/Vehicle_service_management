@model IEnumerable<VehicleServiceManagement.Models.ServiceRequest>

@if (Model == null || !Model.Any())
{
    <div class="p-5 text-center bg-white rounded-3 border">
        <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
        <h6 class="fw-bold text-dark mt-2 mb-1">No Tickets in this Category</h6>
        <p class="text-muted small mb-0">No vehicle service requests match the selected view filter.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive border-0">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">Ticket</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Service Category</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Assigned Staff</th>
                        <th style="width: 100px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-primary">#@request.ServiceRequestId</span>
                            </td>

                            <td>
                                @{
                                    var cust = request.Vehicle?.Customer ?? request.Customer;
                                    var custDisplayName = cust?.Name;
                                    if (string.IsNullOrWhiteSpace(custDisplayName))
                                    {
                                        custDisplayName = cust?.ApplicationUser?.Name;
                                    }
                                    if (string.IsNullOrWhiteSpace(custDisplayName))
                                    {
                                        custDisplayName = request.CustomerName;
                                    }
                                }
                                <div class="d-flex align-items-center gap-2">
                                    <div class="brand-icon" style="width:28px;height:28px;font-size:0.8rem;border-radius:6px;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(custDisplayName) ? "N/A" : custDisplayName)</span>
                                </div>
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-car-front text-muted"></i>
                                    <span class="fw-bold text-dark">@(request.Vehicle?.VehicleNumber ?? "N/A")</span>
                                </div>
                            </td>

                            <td>
                                <span class="fw-bold text-dark d-block">
                                    @Html.Raw((request.ServiceType ?? "").Replace("&amp;", "&"))
                                </span>
                                @if (!string.IsNullOrWhiteSpace(request.Description))
                                {
                                    <span class="text-muted small text-truncate d-inline-block" style="max-width: 200px;" title="@request.Description">
                                        @request.Description
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i> @request.RequestDate.ToString("dd MMM yyyy, HH:mm")
                                </span>
                            </td>

                            <td>
                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-warning-emphasis">
                                        <i class="bi bi-hourglass-split"></i> Pending
                                    </span>
                                }
                                else if (request.Status == "Assigned")
                                {
                                    var activeAssignment = request.ServiceAssignments?
                                        .OrderByDescending(a => a.AssignedDate)
                                        .FirstOrDefault(a => a.Status == "Accepted" || a.Status == "Pending" || a.Status == "In Progress");

                                    if (activeAssignment?.Status == "Pending")
                                    {
                                        <span class="badge bg-info text-info-emphasis">
                                            <i class="bi bi-clock"></i> Response Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary text-primary-emphasis">
                                            <i class="bi bi-person-gear"></i> In Progress
                                        </span>
                                    }
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger text-danger-emphasis">
                                        <i class="bi bi-x-circle"></i> Rejected
                                    </span>
                                }
                                else if (request.Status == "In Progress")
                                {
                                    <span class="badge bg-primary text-primary-emphasis">
                                        <i class="bi bi-gear"></i> In Progress
                                    </span>
                                }
                                else if (request.Status == "Completed")
                                {
                                    <span class="badge bg-success text-success-emphasis">
                                        <i class="bi bi-check2-circle"></i> Completed
                                    </span>
                                }
                                else if (request.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@request.Status</span>
                                }
                            </td>

                            <td>
                                @if (request.Status == "Pending")
                                {
                                    <a asp-controller="ServiceManager"
                                       asp-action="AssignWorker"
                                       asp-route-id="@request.ServiceRequestId"
                                       class="btn btn-success btn-sm">
                                        <i class="bi bi-person-plus"></i> Assign Worker
                                    </a>
                                }
                                else if (request.Status == "Assigned" || request.Status == "In Progress")
                                {
                                    var activeAssignment = request.ServiceAssignments?
                                        .OrderByDescending(a => a.AssignedDate)
                                        .FirstOrDefault(a => a.Status == "Accepted" || a.Status == "Pending" || a.Status == "In Progress");

                                    if (activeAssignment?.Status == "Pending")
                                    {
                                        <div>
                                            @if (activeAssignment.Worker?.ApplicationUser != null)
                                            {
                                                <span class="small text-muted d-block">
                                                    Sent to: <strong>@activeAssignment.Worker.ApplicationUser.Name</strong>
                                                </span>
                                            }
                                            <a asp-controller="ServiceManager"
                                               asp-action="AssignWorker"
                                               asp-route-id="@request.ServiceRequestId"
                                               class="btn btn-outline-warning text-dark btn-sm mt-1">
                                                Reassign
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small">
                                            @if (activeAssignment?.Worker?.ApplicationUser != null)
                                            {
                                                <span class="text-dark fw-semibold">
                                                    <i class="bi bi-wrench me-1 text-primary"></i> @activeAssignment.Worker.ApplicationUser.Name
                                                </span>
                                            }
                                        </div>
                                    }
                                }
                                else if (request.Status == "Rejected")
                                {
                                    var rejectedAssignment = request.ServiceAssignments?
                                        .OrderByDescending(a => a.AssignedDate)
                                        .FirstOrDefault(a => a.Status == "Rejected");

                                    <div>
                                        <span class="text-danger small d-block">
                                            Declined by @(rejectedAssignment?.Worker?.ApplicationUser?.Name ?? "Worker")
                                        </span>
                                        <a asp-controller="ServiceManager"
                                           asp-action="AssignWorker"
                                           asp-route-id="@request.ServiceRequestId"
                                           class="btn btn-warning btn-sm mt-1">
                                            Reassign
                                        </a>
                                    </div>
                                }
                                else if (request.Status == "Completed")
                                {
                                    var compAssignment = request.ServiceAssignments?
                                        .OrderByDescending(a => a.CompletedDate ?? a.AssignedDate)
                                        .FirstOrDefault(a => a.Status == "Completed");

                                    <div class="small">
                                        <span class="text-success fw-semibold">
                                            <i class="bi bi-check-all"></i> Finished
                                        </span>
                                        @if (compAssignment?.Worker?.ApplicationUser != null)
                                        {
                                            <span class="text-muted d-block">by @compAssignment.Worker.ApplicationUser.Name</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>

                            <td class="text-end">
                                <form asp-controller="ServiceManager"
                                      asp-action="DeleteRequest"
                                      asp-route-id="@request.ServiceRequestId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete Service Request #@request.ServiceRequestId? This action cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Ticket">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

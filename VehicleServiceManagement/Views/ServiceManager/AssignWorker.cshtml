@model VehicleServiceManagement.Models.ServiceRequest

@{
    ViewData["Title"] = "Assign Worker";

    var workers =
        ViewBag.Workers
        as IEnumerable<VehicleServiceManagement.Models.Worker>;
    var cleanServiceType = (Model.ServiceType ?? "").Replace("&amp;", "&");
    var rejectedAssignments = Model.ServiceAssignments?.Where(a => a.Status == "Rejected").ToList();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Assign Worker</h2>

        <a asp-action="ServiceRequests"
           class="btn btn-secondary">
            Back to Service Requests
        </a>

    </div>

    <!-- REJECTION NOTICE IF PREVIOUSLY REJECTED -->
    @if (rejectedAssignments != null && rejectedAssignments.Any())
    {
        <div class="alert alert-warning border border-warning shadow-sm mb-4">
            <h6 class="alert-heading fw-bold mb-1">
                <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                Worker Reassignment Needed
            </h6>
            <div>
                This request was previously rejected by:
                <strong>
                    @string.Join(", ", rejectedAssignments.Select(a => a.Worker?.ApplicationUser?.Name ?? $"Worker #{a.WorkerId}"))
                </strong>.
                Please choose another matching available worker below.
            </div>
        </div>
    }

    <!-- SUCCESS / ERROR -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- SERVICE REQUEST -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Service Request Details
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <strong>Request ID</strong>

                    <div>
                        @Model.ServiceRequestId
                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <strong>Service Required</strong>

                    <div>
                        @cleanServiceType
                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <strong>Status</strong>

                    <div>

                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == "Assigned")
                        {
                            <span class="badge bg-primary">
                                Assigned
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger">
                                Worker Rejected
                            </span>
                        }
                        else if (Model.Status == "Completed")
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else if (Model.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">
                                Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }

                    </div>

                </div>

            </div>

            <hr />

            <strong>Description</strong>

            <p class="mt-2">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description provided."
                    : Model.Description)
            </p>


            <hr />

            <div class="row">

                <div class="col-md-6 mb-2">

                    <strong>Vehicle Number</strong>

                    <div>
                        @(Model.Vehicle?.VehicleNumber ?? "N/A")
                    </div>

                </div>

                <div class="col-md-6 mb-2">

                    <strong>Customer</strong>

                    <div>
                        @{
                            var cust = Model.Vehicle?.Customer ?? Model.Customer;
                            var customerDisplayName = cust?.Name;
                            if (string.IsNullOrWhiteSpace(customerDisplayName))
                            {
                                customerDisplayName = cust?.ApplicationUser?.Name;
                            }
                            if (string.IsNullOrWhiteSpace(customerDisplayName))
                            {
                                customerDisplayName = Model.CustomerName;
                            }
                        }
                        @(string.IsNullOrWhiteSpace(customerDisplayName) ? "N/A" : customerDisplayName)
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- MATCHING WORKERS -->

    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                Matching Available Workers
            </h5>

        </div>

        <div class="card-body">

            <div class="alert alert-info">

                Only workers who are:

                <ul class="mb-0 mt-2">

                    <li>Accepted by the Manager</li>

                    <li>Currently available</li>

                    <li>
                        Qualified for
                        <strong>
                            @cleanServiceType
                        </strong>
                    </li>

                </ul>

            </div>


            @if (workers == null || !workers.Any())
            {
                <div class="alert alert-warning">

                    <strong>
                        No matching worker available.
                    </strong>

                    <p class="mb-0 mt-2">

                        There is currently no accepted and
                        available worker who has

                        <strong>
                            @cleanServiceType
                        </strong>

                        as one of their specialities.

                    </p>

                </div>
            }
            else
            {
                <form asp-action="AssignWorker"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="serviceRequestId"
                           value="@Model.ServiceRequestId" />


                    <!-- WORKER -->

                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            Select Worker
                        </label>

                        <select name="workerId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Matching Worker --
                            </option>

                            @foreach (var worker in workers)
                            {
                                <option value="@worker.WorkerId">

                                    @(worker.ApplicationUser?.Name
                                        ?? "Worker #" + worker.WorkerId)

                                    -
                                    @string.Join(
                                        ", ",
                                        worker.Specialities
                                            .Select(s =>
                                                s.Speciality))

                                </option>
                            }

                        </select>

                    </div>


                    <!-- SERVICE DATE -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Service Date
                        </label>

                        <input type="date"
                               name="serviceDate"
                               class="form-control"
                               required />

                    </div>


                    <!-- SERVICE TIME -->

                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            Service Time
                        </label>

                        <input type="time"
                               name="serviceTime"
                               class="form-control"
                               required />

                    </div>


                    <!-- BUTTONS -->

                    <button type="submit"
                            class="btn btn-success">

                        Assign Task

                    </button>

                    <a asp-action="ServiceRequests"
                       class="btn btn-secondary ms-2">

                        Cancel

                    </a>

                </form>
            }

        </div>

    </div>

</div>
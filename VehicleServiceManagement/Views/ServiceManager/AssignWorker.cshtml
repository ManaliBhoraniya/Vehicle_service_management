@model VehicleServiceManagement.Models.ServiceRequest

@{
    ViewData["Title"] = "Assign Technician";

    var workers = ViewBag.Workers as IEnumerable<VehicleServiceManagement.Models.Worker>;
    var cleanServiceType = (Model.ServiceType ?? "").Replace("&amp;", "&");
    var rejectedAssignments = Model.ServiceAssignments?.Where(a => a.Status == "Rejected").ToList();

    var cust = Model.Vehicle?.Customer ?? Model.Customer;
    var customerDisplayName = cust?.Name;
    if (string.IsNullOrWhiteSpace(customerDisplayName))
    {
        customerDisplayName = cust?.ApplicationUser?.Name;
    }
    if (string.IsNullOrWhiteSpace(customerDisplayName))
    {
        customerDisplayName = Model.CustomerName;
    }
    var finalCustomerName = string.IsNullOrWhiteSpace(customerDisplayName) ? "N/A" : customerDisplayName;
}

<div class="py-3">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Assign Technician</h2>
            <p class="text-muted small mb-0">Match this service ticket with qualified and available workshop mechanics.</p>
        </div>

        <a asp-action="ServiceRequests" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Service Requests
        </a>
    </div>

    <!-- REJECTION NOTICE -->
    @if (rejectedAssignments != null && rejectedAssignments.Any())
    {
        <div class="alert alert-warning border border-warning shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-warning me-2"></i>
            <div>
                <strong class="d-block">Reassignment Action Needed</strong>
                <span class="small">
                    This ticket was previously declined by:
                    <strong>@string.Join(", ", rejectedAssignments.Select(a => a.Worker?.ApplicationUser?.Name ?? $"Worker #{a.WorkerId}"))</strong>.
                    Please select an alternate available technician below.
                </span>
            </div>
        </div>
    }

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- TICKET DETAILS SUMMARY -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-ticket-detailed text-primary me-2"></i> Ticket #@Model.ServiceRequestId
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="text-muted small d-block">Requested Service</label>
                        <span class="fs-5 fw-bold text-primary">@cleanServiceType</span>
                    </div>

                    <div class="mb-3 pb-3 border-bottom">
                        <label class="text-muted small d-block">Current Status</label>
                        <span class="badge bg-warning text-warning-emphasis px-3 py-1">@Model.Status</span>
                    </div>

                    <div class="row g-3 mb-3 pb-3 border-bottom">
                        <div class="col-6">
                            <label class="text-muted small d-block">Customer</label>
                            <span class="fw-semibold text-dark">@finalCustomerName</span>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small d-block">Vehicle Plate</label>
                            <span class="fw-bold text-dark">@(Model.Vehicle?.VehicleNumber ?? "N/A")</span>
                        </div>
                    </div>

                    <div>
                        <label class="text-muted small d-block">Customer Remarks</label>
                        <div class="p-3 bg-light rounded-3 small text-dark mt-1">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No remarks provided." : Model.Description)
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TECHNICIAN DISPATCH FORM -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-check text-primary me-2"></i> Match & Schedule Technician
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info py-2 small mb-4">
                        <i class="bi bi-info-circle me-1"></i>
                        Showing only approved, on-duty technicians qualified in <strong>@cleanServiceType</strong>.
                    </div>

                    @if (workers == null || !workers.Any())
                    {
                        <div class="p-4 rounded-3 text-center bg-warning-subtle border border-warning-subtle">
                            <i class="bi bi-person-x-fill text-warning fs-1"></i>
                            <h6 class="fw-bold text-dark mt-2 mb-1">No Matching Technicians Available</h6>
                            <p class="text-muted small mb-0">
                                There are currently no available technicians with <strong>@cleanServiceType</strong> specialty on duty.
                            </p>
                        </div>
                    }
                    else
                    {
                        <form asp-action="AssignWorker" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="serviceRequestId" value="@Model.ServiceRequestId" />

                            <div class="mb-3">
                                <label class="form-label">
                                    <i class="bi bi-person me-1 text-muted"></i> Select Qualified Technician
                                </label>
                                <select name="workerId" class="form-select" required>
                                    <option value="">-- Choose Matching Technician --</option>
                                    @foreach (var worker in workers)
                                    {
                                        <option value="@worker.WorkerId">
                                            @(worker.ApplicationUser?.Name ?? "Worker #" + worker.WorkerId)
                                            - [Skills: @string.Join(", ", worker.Specialities.Select(s => s.Speciality))]
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label">
                                        <i class="bi bi-calendar-event me-1 text-muted"></i> Service Date
                                    </label>
                                    <input type="date" name="serviceDate" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">
                                        <i class="bi bi-clock me-1 text-muted"></i> Scheduled Time
                                    </label>
                                    <input type="time" name="serviceTime" class="form-control" required />
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success px-4">
                                    <i class="bi bi-send-check"></i> Assign Task
                                </button>
                                <a asp-action="ServiceRequests" class="btn btn-outline-secondary">
                                    Cancel
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
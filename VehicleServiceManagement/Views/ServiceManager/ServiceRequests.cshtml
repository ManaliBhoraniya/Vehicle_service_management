@model IEnumerable<VehicleServiceManagement.Models.ServiceRequest>

@{
    ViewData["Title"] = "Manage Service Requests";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Service Requests</h2>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No service requests found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Service Required</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Worker Task</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var request in Model)
                    {
                        <tr>

                            <td>
                                @request.ServiceRequestId
                            </td>

                            <td>
                                @request.Vehicle?.Customer?.Name
                            </td>

                            <td>
                                @request.Vehicle?.VehicleNumber
                            </td>

                            <td>
                                <strong>
                                    @request.ServiceType
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(request.Description))
                                {
                                    <br />

                                    <small class="text-muted">
                                        @request.Description
                                    </small>
                                }
                            </td>

                            <td>
                                @request.RequestDate.ToString("dd-MM-yyyy HH:mm")
                            </td>

                            <td>

                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (request.Status == "Assigned")
                                {
                                    <span class="badge bg-primary">
                                        Assigned
                                    </span>
                                }
                                else if (request.Status == "Completed")
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else if (request.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @request.Status
                                    </span>
                                }

                            </td>

                            <td>

                                @if (request.Status == "Pending")
                                {
                                    <a asp-controller="ServiceManager"
                                       asp-action="AssignWorker"
                                       asp-route-id="@request.ServiceRequestId"
                                       class="btn btn-success btn-sm">
                                        Assign Worker
                                    </a>
                                }
                                else if (request.Status == "Assigned")
                                {
                                    <span class="badge bg-primary">
                                        Worker Accepted
                                    </span>
                                }
                                else if (request.Status == "Completed")
                                {
                                    <span class="badge bg-success">
                                        Task Completed
                                    </span>
                                }
                                else if (request.Status == "Cancelled")
                                {
                                    <span class="text-muted">
                                        Cancelled
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
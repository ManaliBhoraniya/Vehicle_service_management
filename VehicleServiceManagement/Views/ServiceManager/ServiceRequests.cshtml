@model IEnumerable<VehicleServiceManagement.Models.ServiceRequest>

@{
    ViewData["Title"] = "Manage Service Requests";
}

@functions {
    string GetRequestCategory(VehicleServiceManagement.Models.ServiceRequest req)
    {
        if (req.Status == "Completed")
            return "Completed";

        if (req.Status == "Cancelled")
            return "Cancelled";

        if (req.Status == "Rejected")
            return "Worker Rejected";

        var activeAssignment = req.ServiceAssignments?
            .OrderByDescending(a => a.AssignedDate)
            .FirstOrDefault(a => a.Status == "Accepted" || a.Status == "Pending" || a.Status == "In Progress" || a.Status == "Rejected");

        if (req.Status == "Assigned")
        {
            if (activeAssignment?.Status == "Pending")
                return "Waiting for Worker Response";

            if (activeAssignment?.Status == "Rejected")
                return "Worker Rejected";

            return "In Progress";
        }

        if (req.Status == "In Progress")
            return "In Progress";

        if (req.Status == "Pending")
            return "Pending";

        return req.Status ?? "Pending";
    }
}

@{
    var allRequests = (Model ?? Enumerable.Empty<VehicleServiceManagement.Models.ServiceRequest>()).ToList();
    var pendingRequests = allRequests.Where(r => GetRequestCategory(r) == "Pending").ToList();
    var waitingRequests = allRequests.Where(r => GetRequestCategory(r) == "Waiting for Worker Response").ToList();
    var inProgressRequests = allRequests.Where(r => GetRequestCategory(r) == "In Progress").ToList();
    var rejectedRequests = allRequests.Where(r => GetRequestCategory(r) == "Worker Rejected").ToList();
    var completedRequests = allRequests.Where(r => GetRequestCategory(r) == "Completed").ToList();
}

<div class="container mt-4">

    <div class="mb-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="history.back();">
            &larr; Back
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Manage Service Requests</h2>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- STATUS TABS -->
    <ul class="nav nav-pills mb-4 flex-wrap gap-2" id="requestStatusTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="all-tab" data-bs-toggle="pill" data-bs-target="#tab-all" type="button" role="tab" aria-controls="tab-all" aria-selected="true">
                All Requests
                <span class="badge bg-secondary ms-1">@allRequests.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="pending-tab" data-bs-toggle="pill" data-bs-target="#tab-pending" type="button" role="tab" aria-controls="tab-pending" aria-selected="false">
                Pending
                <span class="badge bg-warning text-dark ms-1">@pendingRequests.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="waiting-tab" data-bs-toggle="pill" data-bs-target="#tab-waiting" type="button" role="tab" aria-controls="tab-waiting" aria-selected="false">
                Waiting for Worker Response
                <span class="badge bg-info text-dark ms-1">@waitingRequests.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="inprogress-tab" data-bs-toggle="pill" data-bs-target="#tab-inprogress" type="button" role="tab" aria-controls="tab-inprogress" aria-selected="false">
                In Progress
                <span class="badge bg-primary ms-1">@inProgressRequests.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-danger" id="rejected-tab" data-bs-toggle="pill" data-bs-target="#tab-rejected" type="button" role="tab" aria-controls="tab-rejected" aria-selected="false">
                Worker Rejected
                <span class="badge bg-danger ms-1">@rejectedRequests.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="completed-tab" data-bs-toggle="pill" data-bs-target="#tab-completed" type="button" role="tab" aria-controls="tab-completed" aria-selected="false">
                Completed
                <span class="badge bg-success ms-1">@completedRequests.Count</span>
            </button>
        </li>
    </ul>

    <!-- TAB CONTENTS -->
    <div class="tab-content" id="requestStatusTabsContent">
        <div class="tab-pane fade show active" id="tab-all" role="tabpanel" aria-labelledby="all-tab">
            @await Html.PartialAsync("_ServiceRequestTable", allRequests)
        </div>

        <div class="tab-pane fade" id="tab-pending" role="tabpanel" aria-labelledby="pending-tab">
            @await Html.PartialAsync("_ServiceRequestTable", pendingRequests)
        </div>

        <div class="tab-pane fade" id="tab-waiting" role="tabpanel" aria-labelledby="waiting-tab">
            @await Html.PartialAsync("_ServiceRequestTable", waitingRequests)
        </div>

        <div class="tab-pane fade" id="tab-inprogress" role="tabpanel" aria-labelledby="inprogress-tab">
            @await Html.PartialAsync("_ServiceRequestTable", inProgressRequests)
        </div>

        <div class="tab-pane fade" id="tab-rejected" role="tabpanel" aria-labelledby="rejected-tab">
            @await Html.PartialAsync("_ServiceRequestTable", rejectedRequests)
        </div>

        <div class="tab-pane fade" id="tab-completed" role="tabpanel" aria-labelledby="completed-tab">
            @await Html.PartialAsync("_ServiceRequestTable", completedRequests)
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const storageKey = 'serviceRequests_activeTab';
            const tabButtons = document.querySelectorAll('#requestStatusTabs button[data-bs-toggle="pill"]');

            tabButtons.forEach(btn => {
                btn.addEventListener('shown.bs.tab', function (e) {
                    localStorage.setItem(storageKey, e.target.getAttribute('data-bs-target'));
                });
            });

            const savedTab = localStorage.getItem(storageKey);
            if (savedTab) {
                const targetBtn = document.querySelector(`#requestStatusTabs button[data-bs-target="${savedTab}"]`);
                if (targetBtn) {
                    const tabInstance = new bootstrap.Tab(targetBtn);
                    tabInstance.show();
                }
            }
        });
    </script>
}
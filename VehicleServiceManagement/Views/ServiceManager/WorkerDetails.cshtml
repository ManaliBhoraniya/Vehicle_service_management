@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Worker Details";
}

<div class="container mt-4">

    <!-- TOP NAVIGATION -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Workers" class="btn btn-outline-secondary btn-sm mb-2">
                &larr; Back to Workers
            </a>
            <h2 class="mb-0">Worker Details</h2>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PROFILE HEADER CARD -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3 class="mb-1 text-primary fw-bold">
                    @(Model.ApplicationUser?.Name ?? "Worker #" + Model.WorkerId)
                </h3>
                <p class="text-muted mb-0">
                    Worker ID: <strong>#@Model.WorkerId</strong> &bull; Email: <strong>@(Model.ApplicationUser?.Email ?? "N/A")</strong>
                </p>
            </div>

            <div class="d-flex gap-2 align-items-center">
                @if (Model.Status == "Accepted")
                {
                    <span class="badge bg-success fs-6 px-3 py-2">
                        Accepted
                    </span>
                }
                else if (Model.Status == "Pending")
                {
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                        Pending Approval
                    </span>
                }
                else
                {
                    <span class="badge bg-danger fs-6 px-3 py-2">
                        @Model.Status
                    </span>
                }

                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success fs-6 px-3 py-2">
                        Available
                    </span>
                }
                else
                {
                    <span class="badge bg-danger fs-6 px-3 py-2">
                        Unavailable
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- DETAILS ROW -->
    <div class="row">

        <!-- LEFT COLUMN: CONTACT & RESUME -->
        <div class="col-md-6 mb-4">

            <!-- CONTACT INFO -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Contact Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th style="width: 35%;" class="text-muted">Full Name</th>
                                <td>@(Model.ApplicationUser?.Name ?? "N/A")</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Email</th>
                                <td>@(Model.ApplicationUser?.Email ?? "N/A")</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Phone</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.ApplicationUser?.PhoneNumber) ? "Not provided" : Model.ApplicationUser.PhoneNumber)</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Approval Status</th>
                                <td>@Model.Status</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Work Availability</th>
                                <td>
                                    @(Model.IsAvailable ? "Available for new tasks" : "Currently occupied / unavailable")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- RESUME CARD -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Resume / Qualification Document</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ResumeFilePath))
                    {
                        <div class="mb-3">
                            <strong>File Name:</strong>
                            <span class="text-break">@(Model.ResumeFileName ?? "Worker Resume")</span>
                        </div>
                        <a href="@Model.ResumeFilePath"
                           target="_blank"
                           class="btn btn-outline-primary">
                            View / Download Resume
                        </a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No resume uploaded by this worker.
                        </p>
                    }
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: SPECIALITIES & SCHEDULE -->
        <div class="col-md-6 mb-4">

            <!-- SPECIALITIES -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Specialities & Skills</h5>
                </div>
                <div class="card-body">
                    @if (Model.Specialities != null && Model.Specialities.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var spec in Model.Specialities)
                            {
                                <span class="badge bg-primary fs-6 px-3 py-2">
                                    @spec.Speciality
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No specialities recorded for this worker.
                        </p>
                    }
                </div>
            </div>

            <!-- AVAILABILITY SCHEDULE -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Availability Schedule</h5>
                </div>
                <div class="card-body">
                    @if (Model.Availabilities != null && Model.Availabilities.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Day</th>
                                        <th>Hours</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var avail in Model.Availabilities)
                                    {
                                        <tr>
                                            <td><strong>@avail.DayOfWeek</strong></td>
                                            <td>
                                                @if (avail.StartTime.HasValue && avail.EndTime.HasValue)
                                                {
                                                    @($"{avail.StartTime.Value.ToString(@"hh\:mm")} - {avail.EndTime.Value.ToString(@"hh\:mm")}")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Full Day</span>
                                                }
                                            </td>
                                            <td>
                                                @if (avail.IsAvailable)
                                                {
                                                    <span class="badge bg-success">Available</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Off</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No custom availability schedule configured. Worker operates under standard schedule.
                        </p>
                    }
                </div>
            </div>

        </div>

    </div>

    <!-- ASSIGNED SERVICES / WORK HISTORY -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Assigned Tasks & Service History</h5>
            <span class="badge bg-secondary">
                @(Model.ServiceAssignments?.Count ?? 0) Task(s)
            </span>
        </div>

        <div class="card-body">
            @if (Model.ServiceAssignments == null || !Model.ServiceAssignments.Any())
            {
                <p class="text-muted mb-0">
                    No tasks have been assigned to this worker yet.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Assignment ID</th>
                                <th>Request ID</th>
                                <th>Customer</th>
                                <th>Vehicle</th>
                                <th>Service Required</th>
                                <th>Assigned Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.ServiceAssignments.OrderByDescending(a => a.AssignedDate))
                            {
                                var req = assignment.ServiceRequest;
                                var cust = req?.Vehicle?.Customer ?? req?.Customer;
                                var custName = cust?.Name ?? cust?.ApplicationUser?.Name ?? req?.CustomerName ?? "N/A";

                                <tr>
                                    <td>#@assignment.ServiceAssignmentId</td>
                                    <td>
                                        @if (req != null)
                                        {
                                            <a asp-action="AssignWorker" asp-route-id="@req.ServiceRequestId" class="fw-bold">
                                                #@req.ServiceRequestId
                                            </a>
                                        }
                                        else
                                        {
                                            <span>#@assignment.ServiceRequestId</span>
                                        }
                                    </td>
                                    <td>@custName</td>
                                    <td>@(req?.Vehicle?.VehicleNumber ?? "N/A")</td>
                                    <td>
                                        <strong>@Html.Raw((req?.ServiceType ?? "N/A").Replace("&amp;", "&"))</strong>
                                    </td>
                                    <td>@assignment.AssignedDate.ToString("dd-MM-yyyy HH:mm")</td>
                                    <td>
                                        @if (assignment.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending Acceptance</span>
                                        }
                                        else if (assignment.Status == "Accepted" || assignment.Status == "Assigned")
                                        {
                                            <span class="badge bg-info text-dark">Accepted</span>
                                        }
                                        else if (assignment.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">In Progress</span>
                                        }
                                        else if (assignment.Status == "Completed")
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else if (assignment.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected by Worker</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@assignment.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

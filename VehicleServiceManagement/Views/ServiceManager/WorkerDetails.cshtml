@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Technician Details";
}

<div class="py-3">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Technician Details</h2>
            <p class="text-muted small mb-0">Evaluate staff profile, licenses, working status, and recent activity.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Workers" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Roster
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                Dashboard
            </a>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PROFILE HERO CARD -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-icon" style="width:52px;height:52px;font-size:1.6rem;border-radius:12px;">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-dark mb-0">
                        @(Model.ApplicationUser?.Name ?? "Worker #" + Model.WorkerId)
                    </h3>
                    <p class="text-muted small mb-0">
                        ID: <strong>#@Model.WorkerId</strong> &bull; Email: <strong>@(Model.ApplicationUser?.Email ?? "N/A")</strong>
                    </p>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center">
                @if (Model.Status == "Accepted")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="bi bi-check-circle-fill"></i> Approved Technician
                    </span>
                }
                else if (Model.Status == "Pending")
                {
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                        <i class="bi bi-hourglass-split"></i> Pending Application
                    </span>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                        @Model.Status
                    </span>
                }

                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="bi bi-circle-fill text-success" style="font-size:0.6rem;"></i> On Duty
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-2">
                        <i class="bi bi-dash-circle"></i> Off Duty
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- CONTACT & SPECIALTIES -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-info-circle text-primary me-2"></i> Professional Profile
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Full Name</span>
                            <span class="fw-bold text-dark fs-6">@(Model.ApplicationUser?.Name ?? "N/A")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Username</span>
                            <span class="fw-semibold text-dark">@(Model.ApplicationUser?.UserName ?? "N/A")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Email</span>
                            <span class="fw-semibold text-dark">@(Model.ApplicationUser?.Email ?? "N/A")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Phone</span>
                            <span class="fw-semibold text-dark">@(Model.ApplicationUser?.PhoneNumber ?? "N/A")</span>
                        </div>
                    </div>

                    <div class="pt-3 border-top">
                        <span class="fw-semibold text-dark d-block mb-2">Certified Specialties:</span>
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.Specialities != null && Model.Specialities.Any())
                            {
                                foreach (var speciality in Model.Specialities)
                                {
                                    <span class="badge bg-primary text-primary-emphasis px-3 py-2">
                                        <i class="bi bi-patch-check-fill me-1"></i> @speciality.Speciality
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">No specialities linked</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RESUME & APPLICATION ACTIONS -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-file-earmark-pdf text-primary me-2"></i> Resume & Documents
                    </h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        @if (!string.IsNullOrEmpty(Model.ResumeFilePath))
                        {
                            <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between border mb-3">
                                <div>
                                    <span class="fw-semibold text-dark d-block">@Model.ResumeFileName</span>
                                    <span class="text-muted small">Applicant Resume File</span>
                                </div>
                                <a href="@Model.ResumeFilePath" target="_blank" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-download"></i> View
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">No resume file uploaded by applicant.</p>
                        }
                    </div>

                    @if (Model.Status == "Pending")
                    {
                        <div class="p-3 bg-warning-subtle border border-warning-subtle rounded-3 mt-3">
                            <h6 class="fw-bold text-dark mb-2">Pending Decision</h6>
                            <div class="d-flex gap-2">
                                <form asp-action="AcceptJobRequest" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.WorkerId" />
                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                </form>

                                <form asp-action="RejectJobRequest" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.WorkerId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100" onclick="return confirm('Are you sure you want to reject this applicant?');">
                                        <i class="bi bi-x-lg"></i> Decline
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

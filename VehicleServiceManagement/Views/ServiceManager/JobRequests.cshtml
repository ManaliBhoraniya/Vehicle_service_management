@model IEnumerable<VehicleServiceManagement.Models.Worker>

@{
    ViewData["Title"] = "Technician Applications";
}

<div class="py-3">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Technician Job Applications</h2>
            <p class="text-muted small mb-0">Evaluate new mechanic registrations, review resumes, and approve staff access.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <div class="feature-icon-wrapper icon-success mx-auto mb-3" style="width:64px;height:64px;font-size:2rem;">
                <i class="bi bi-check2-circle"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">Queue Clear</h5>
            <p class="text-muted small mb-0">No pending technician applications awaiting review.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive border-0">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Applicant</th>
                            <th>Email Address</th>
                            <th>Proposed Specialties</th>
                            <th>Resume / Credentials</th>
                            <th class="text-end">Decision Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var worker in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="brand-icon" style="width:34px;height:34px;font-size:1rem;border-radius:8px;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@(worker.ApplicationUser?.Name ?? "Applicant")</span>
                                            <span class="text-muted small">Application #@worker.WorkerId</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted">@(worker.ApplicationUser?.Email ?? "-")</span>
                                </td>
                                <td>
                                    @if (worker.Specialities != null && worker.Specialities.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var speciality in worker.Specialities)
                                            {
                                                <span class="badge bg-primary text-primary-emphasis">
                                                    @speciality.Speciality
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No specialities selected</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(worker.ResumeFilePath))
                                    {
                                        <a href="@worker.ResumeFilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-file-earmark-pdf"></i> View Resume
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-semibold">
                                            <i class="bi bi-x-circle"></i> No Resume
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <!-- ACCEPT -->
                                        <form asp-action="AcceptJobRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@worker.WorkerId" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                        </form>

                                        <!-- REJECT -->
                                        <form asp-action="RejectJobRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@worker.WorkerId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to reject this job request?');">
                                                <i class="bi bi-x-lg"></i> Decline
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
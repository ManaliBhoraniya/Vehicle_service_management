@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Delete Worker";
}

<h2>Delete Worker</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this worker?
</div>

<div class="card shadow-sm">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-4">
                Worker ID
            </dt>

            <dd class="col-sm-8">
                @Model.Id
            </dd>

            <dt class="col-sm-4">
                Name
            </dt>

            <dd class="col-sm-8">
                @Model.ApplicationUser?.Name
            </dd>

            <dt class="col-sm-4">
                Username
            </dt>

            <dd class="col-sm-8">
                @Model.ApplicationUser?.UserName
            </dd>

            <dt class="col-sm-4">
                Email
            </dt>

            <dd class="col-sm-8">
                @Model.ApplicationUser?.Email
            </dd>

            <dt class="col-sm-4">
                Profession
            </dt>

            <dd class="col-sm-8">
                @Model.Profession
            </dd>

            <dt class="col-sm-4">
                Availability
            </dt>

            <dd class="col-sm-8">

                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success">
                        Available
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Busy
                    </span>
                }

            </dd>

        </dl>

        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger">
                Yes, Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>
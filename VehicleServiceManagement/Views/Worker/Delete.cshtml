@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Delete Worker";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-6">
        <div class="card border-danger border-opacity-25 shadow-sm">
            <div class="card-header bg-danger-subtle bg-opacity-25 py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <h5 class="fw-bold text-danger mb-0">Confirm Worker Removal</h5>
                </div>
            </div>

            <div class="card-body p-4">
                <p class="text-muted">
                    Are you sure you want to permanently remove this technician? All assignments and historical job logs associated with this worker account will be affected.
                </p>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Worker ID:</span>
                            <strong class="text-dark">#@Model.WorkerId</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Name:</span>
                            <strong class="text-dark">@(Model.ApplicationUser?.Name ?? "N/A")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Email:</span>
                            <span class="text-muted">@(Model.ApplicationUser?.Email ?? "N/A")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Status:</span>
                            <span class="badge bg-secondary">@Model.Status</span>
                        </div>
                    </div>
                </div>

                <form asp-controller="Worker"
                      asp-action="Delete"
                      asp-route-id="@Model.WorkerId"
                      method="post">
                    @Html.AntiForgeryToken()

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash"></i> Yes, Delete Worker
                        </button>
                        <a asp-controller="ServiceManager" asp-action="Workers" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
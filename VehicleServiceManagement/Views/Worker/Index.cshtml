@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">My Profile</h2>

            <p class="text-muted mb-0">
                View and manage your worker profile.
            </p>
        </div>

        <a asp-controller="Worker"
           asp-action="Dashboard"
           class="btn btn-outline-primary">
            Dashboard
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                Worker Information
            </h5>

        </div>


        <div class="card-body">

            <div class="row">

                <!-- LEFT SIDE -->

                <div class="col-md-6">

                    <div class="mb-3">

                        <strong>Name</strong>

                        <div>
                            @(Model.ApplicationUser?.Name ?? "Not provided")
                        </div>

                    </div>


                    <div class="mb-3">

                        <strong>Username</strong>

                        <div>
                            @(Model.ApplicationUser?.UserName ?? "Not provided")
                        </div>

                    </div>


                    <div class="mb-3">

                        <strong>Email</strong>

                        <div>
                            @(Model.ApplicationUser?.Email ?? "Not provided")
                        </div>

                    </div>


                    <div class="mb-3">

                        <strong>Phone</strong>

                        <div>
                            @(Model.ApplicationUser?.PhoneNumber ?? "Not provided")
                        </div>

                    </div>

                </div>


                <!-- RIGHT SIDE -->

                <div class="col-md-6">

                    <div class="mb-3">

                        <strong>Specialities</strong>

                        <div class="mt-2">

                            @if (Model.Specialities != null &&
                                 Model.Specialities.Any())
                            {
                                foreach (var speciality in Model.Specialities)
                                {
                                    <span class="badge bg-primary me-1 mb-1">
                                        @speciality.Speciality
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    No specialities selected.
                                </span>
                            }

                        </div>

                    </div>


                    <div class="mb-3">

                        <strong>Status</strong>

                        <div class="mt-1">

                            @if (Model.Status == "Accepted")
                            {
                                <span class="badge bg-success">
                                    Accepted
                                </span>
                            }
                            else if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending Approval
                                </span>
                            }
                            else if (Model.Status == "Rejected")
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Model.Status
                                </span>
                            }

                        </div>

                    </div>


                    <div class="mb-3">

                        <strong>Availability</strong>

                        <div class="mt-1">

                            @if (Model.IsAvailable)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Not Available
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>


            <hr />


            <!-- RESUME -->

            <div class="mb-4">

                <h5>
                    Resume
                </h5>


                @if (!string.IsNullOrEmpty(Model.ResumeFilePath))
                {
                    <div class="mb-2">

                        <strong>
                            @Model.ResumeFileName
                        </strong>

                    </div>


                    <a href="@Model.ResumeFilePath"
                       target="_blank"
                       class="btn btn-outline-primary">
                        View Resume
                    </a>
                }
                else
                {
                    <p class="text-muted">
                        No resume uploaded.
                    </p>
                }

            </div>


            <hr />


            <!-- ACTIONS -->

            <div class="d-flex gap-2 flex-wrap">

                <a asp-controller="Worker"
                   asp-action="Edit"
                   class="btn btn-primary">
                    Edit Profile
                </a>


                <a asp-controller="Worker"
                   asp-action="MyServices"
                   class="btn btn-outline-primary">
                    My Services
                </a>


                <a asp-controller="Worker"
                   asp-action="Availability"
                   class="btn btn-outline-secondary">
                    Manage Availability
                </a>

            </div>

        </div>

    </div>

</div>
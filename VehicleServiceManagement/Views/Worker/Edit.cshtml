@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Edit Technician Profile";

    var specialityOptions = new[]
    {
        "Engine Repair",
        "Brake Repair",
        "Oil Change",
        "AC Repair",
        "Electrical Repair",
        "Tire & Wheel Service",
        "Transmission Repair",
        "General Service"
    };
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="brand-icon" style="width: 34px; height: 34px; font-size: 1rem;">
                        <i class="bi bi-pencil-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Edit Technician Profile</h4>
                        <p class="text-muted small mb-0">Update your contact details and active automotive specialties</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-controller="Worker" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workerId" value="@Model.WorkerId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="bi bi-person me-1 text-muted"></i> Full Name
                            </label>
                            <input type="text"
                                   name="name"
                                   value="@Model.ApplicationUser?.Name"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="bi bi-telephone me-1 text-muted"></i> Phone Number
                            </label>
                            <input type="text"
                                   name="phone"
                                   value="@Model.ApplicationUser?.PhoneNumber"
                                   class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                <i class="bi bi-envelope me-1 text-muted"></i> Registered Email (Read-Only)
                            </label>
                            <input type="text"
                                   value="@Model.ApplicationUser?.Email"
                                   class="form-control bg-light"
                                   readonly />
                        </div>
                    </div>

                    <div class="mb-4 pt-3 border-top">
                        <label class="form-label fw-bold mb-2">
                            <i class="bi bi-patch-check me-1 text-primary"></i> Certified Specialties
                        </label>
                        <p class="text-muted small mb-3">Select the repairs and maintenance areas you are qualified to handle.</p>

                        <div class="row g-2">
                            @foreach (var speciality in specialityOptions)
                            {
                                var selected = Model.Specialities != null && Model.Specialities.Any(s => s.Speciality == speciality);
                                <div class="col-sm-6">
                                    <div class="form-check p-2 bg-light rounded border">
                                        <input type="checkbox"
                                               class="form-check-input ms-1"
                                               name="specialities"
                                               value="@speciality"
                                               id="speciality_@speciality.GetHashCode()"
                                               @(selected ? "checked" : "") />
                                        <label class="form-check-label ms-2 fw-medium text-dark" for="speciality_@speciality.GetHashCode()">
                                            @speciality
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg"></i> Save Profile
                        </button>
                        <a asp-controller="Worker" asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
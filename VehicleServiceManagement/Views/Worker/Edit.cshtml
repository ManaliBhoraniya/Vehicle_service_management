@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Edit Worker";

    var specialityOptions = new[]
    {
        "Engine Repair",
        "Brake Repair",
        "Oil Change",
        "AC Repair",
        "Electrical Repair",
        "Tire & Wheel Service",
        "Transmission Repair",
        "General Service"
    };
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h3 class="mb-0">Edit Profile</h3>
        </div>

        <div class="card-body">

            <form asp-controller="Worker"
                  asp-action="Edit"
                  method="post">

                <input type="hidden"
                       name="workerId"
                       value="@Model.WorkerId" />

                <div class="mb-3">

                    <label class="form-label">
                        Name
                    </label>

                    <input type="text"
                           name="name"
                           value="@Model.ApplicationUser?.Name"
                           class="form-control"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Phone
                    </label>

                    <input type="text"
                           name="phone"
                           value="@Model.ApplicationUser?.PhoneNumber"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Email
                    </label>

                    <input type="text"
                           value="@Model.ApplicationUser?.Email"
                           class="form-control"
                           readonly />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Specialities
                    </label>

                    <div class="row">

                        @foreach (var speciality in specialityOptions)
                        {
                            var selected =
                                Model.Specialities != null &&
                                Model.Specialities.Any(
                                    s => s.Speciality == speciality);

                            <div class="col-md-6 col-lg-4 mb-2">

                                <div class="form-check">

                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="specialities"
                                           value="@speciality"
                                           id="speciality_@speciality.GetHashCode()"
                                           @(selected ? "checked" : "") />

                                    <label class="form-check-label"
                                           for="speciality_@speciality.GetHashCode()">
                                        @speciality
                                    </label>

                                </div>

                            </div>
                        }

                    </div>

                    <small class="text-muted">
                        Select at least one speciality.
                    </small>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-controller="Worker"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>
@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Edit Worker";
}

<h2>Edit Worker</h2>

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post">

    ```
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="UserId"
               class="form-label">
            User ID
        </label>

        <input asp-for="UserId"
               class="form-control" />

        <span asp-validation-for="UserId"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
    ```

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Edit Profile</h3>
                </div>

                <div class="card-body">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    <form asp-action="Edit"
                          asp-controller="Worker"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- IMPORTANT: send WorkerId using the exact
                             parameter name expected by the controller -->
                        <input type="hidden"
                               name="workerId"
                               value="@Model.WorkerId" />

                        <div class="mb-3">
                            <label class="form-label">
                                Username / Email
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.ApplicationUser?.UserName"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label for="name" class="form-label">
                                Full Name
                            </label>

                            <input type="text"
                                   id="name"
                                   name="name"
                                   class="form-control"
                                   value="@Model.ApplicationUser?.Name"
                                   required />

                            <span class="text-danger">
                                @Html.ValidationMessage("Name")
                            </span>
                        </div>

                        <div class="mb-3">
                            <label for="phone" class="form-label">
                                Phone Number
                            </label>

                            <input type="text"
                                   id="phone"
                                   name="phone"
                                   class="form-control"
                                   value="@Model.ApplicationUser?.PhoneNumber" />

                            <span class="text-danger">
                                @Html.ValidationMessage("Phone")
                            </span>
                        </div>

                        <div class="mb-3">
                            <label for="profession" class="form-label">
                                Profession
                            </label>

                            <input type="text"
                                   id="profession"
                                   name="profession"
                                   class="form-control"
                                   value="@Model.Profession"
                                   required />

                            <span class="text-danger">
                                @Html.ValidationMessage("Profession")
                            </span>
                        </div>

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-controller="Worker"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Edit Worker";
}

<h2>Edit Worker</h2>

<form asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="Id" />

    <input type="hidden"
           asp-for="ApplicationUserId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">

        <label class="form-label">
            Application User
        </label>

        <input class="form-control"
               value="@Model.ApplicationUser?.UserName"
               readonly />

    </div>

    <div class="mb-3">

        <label asp-for="Profession"
               class="form-label">
            Profession
        </label>

        <input asp-for="Profession"
               class="form-control" />

        <span asp-validation-for="Profession"
              class="text-danger">
        </span>

    </div>

    <div class="mb-3 form-check">

        <input asp-for="IsAvailable"
               class="form-check-input" />

        <label asp-for="IsAvailable"
               class="form-check-label">
            Is Available
        </label>

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
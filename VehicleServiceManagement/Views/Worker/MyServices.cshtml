@model IEnumerable<VehicleServiceManagement.Models.ServiceAssignment>

@{
    ViewData["Title"] = "My Work";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between">

        <h1>My Work</h1>

        <a asp-action="Dashboard"
           class="btn btn-secondary">
            Dashboard
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm mt-3">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-dark">

                            <tr>
                                <th>Service</th>
                                <th>Description</th>
                                <th>Assigned Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @(item.ServiceRequest
                                            ?.ServiceType
                                            ?? "Service")
                                    </td>

                                    <td>
                                        @(item.ServiceRequest
                                            ?.Description
                                            ?? "-")
                                    </td>

                                    <td>
                                        @item.AssignedDate
                                        .ToString(
                                        "dd-MM-yyyy")
                                    </td>

                                    <td>

                                        @if (item.Status
                                            == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (
                                            item.Status
                                            == "In Progress")
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else if (
                                            item.Status
                                            == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (item.Status
                                            == "Pending")
                                        {
                                            <form asp-action="StartService"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="assignmentId"
                                                       value="@item.ServiceAssignmentId" />

                                                <button type="submit"
                                                        class="btn btn-primary btn-sm">
                                                    Start Work
                                                </button>

                                            </form>
                                        }
                                        else if (
                                            item.Status
                                            == "In Progress")
                                        {
                                            <form asp-action="CompleteService"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="assignmentId"
                                                       value="@item.ServiceAssignmentId" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    Complete
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Completed
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No work has been assigned to you yet.
                </div>
            }

        </div>

    </div>

</div>
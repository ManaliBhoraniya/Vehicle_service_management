@model IEnumerable<VehicleServiceManagement.Models.ServiceAssignment>

@{
    ViewData["Title"] = "My Assigned Work";
    var isAvailable = (bool)(ViewBag.IsAvailable ?? false);
}

<div class="py-3">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Assigned Work</h2>
            <p class="text-muted small mb-0">Manage and execute your allocated vehicle maintenance and repair tickets.</p>
        </div>

        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Technician Dashboard
        </a>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- AVAILABILITY STATUS BANNER -->
    <div class="card border-0 shadow-sm mb-4 @(isAvailable ? "bg-success-subtle" : "bg-danger-subtle")">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @(isAvailable ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") fs-4"></i>
                <div>
                    <span class="fw-bold text-dark d-block">
                        @(isAvailable ? "You are Available for Dispatch" : "You are Marked As Unavailable")
                    </span>
                    <span class="text-muted small">
                        @(isAvailable ? "Managers can assign new incoming customer tickets to you." : "Toggle status when you are ready to receive new maintenance jobs.")
                    </span>
                </div>
            </div>

            <div>
                @if (isAvailable)
                {
                    <form asp-action="UpdateAvailability" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="isAvailable" value="false" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-pause-fill"></i> Mark Unavailable
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="UpdateAvailability" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="isAvailable" value="true" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-play-fill"></i> Mark Available
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- SERVICES TABLE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-tools text-primary me-2"></i> Work Queue
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive border-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Service Category</th>
                                <th>Vehicle & Customer</th>
                                <th>Problem Remarks</th>
                                <th>Assigned Date</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-dark">
                                            @(item.ServiceRequest?.ServiceType ?? "Service")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-car-front text-muted"></i>
                                            <div>
                                                <span class="fw-semibold text-dark d-block">
                                                    @(item.ServiceRequest?.Vehicle?.VehicleNumber ?? "-")
                                                </span>
                                                @{
                                                    var cust = item.ServiceRequest?.Vehicle?.Customer ?? item.ServiceRequest?.Customer;
                                                    var custName = cust?.Name ?? cust?.ApplicationUser?.Name ?? item.ServiceRequest?.CustomerName;
                                                    if (!string.IsNullOrWhiteSpace(custName))
                                                    {
                                                        <small class="text-muted">Customer: @custName</small>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small text-truncate d-inline-block" style="max-width: 220px;" title="@(item.ServiceRequest?.Description ?? "-")">
                                            @(item.ServiceRequest?.Description ?? "-")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">
                                            @item.AssignedDate.ToString("dd MMM yyyy, HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-warning-emphasis">Pending Response</span>
                                        }
                                        else if (item.Status == "Accepted" || item.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary text-primary-emphasis">In Progress</span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-success text-success-emphasis">Completed</span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger text-danger-emphasis">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (item.Status == "Pending")
                                        {
                                            <div class="d-inline-flex gap-1">
                                                <form asp-action="StartService" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="assignmentId" value="@item.ServiceAssignmentId" />
                                                    <button type="submit" class="btn btn-primary btn-sm">
                                                        <i class="bi bi-play-circle"></i> Start
                                                    </button>
                                                </form>

                                                <form asp-action="RejectTask" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="assignmentId" value="@item.ServiceAssignmentId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to reject this task?');">
                                                        Decline
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (item.Status == "Accepted" || item.Status == "In Progress")
                                        {
                                            <form asp-action="CompleteService" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="assignmentId" value="@item.ServiceAssignmentId" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="bi bi-check2-circle"></i> Mark Completed
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="text-success small fw-semibold">
                                                <i class="bi bi-check-all"></i> Finished
                                            </span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="text-muted small">
                                                <i class="bi bi-x-circle"></i> Declined
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <i class="bi bi-clipboard-check text-muted" style="font-size: 3rem;"></i>
                    <h6 class="fw-bold text-dark mt-3">No Assigned Tasks Yet</h6>
                    <p class="text-muted small mb-0">When service managers route customer requests to you, they will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>
@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Worker Details";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h3 class="mb-0">Worker Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Worker ID</dt>
                <dd class="col-sm-9">@Model.WorkerId</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">
                    @(Model.ApplicationUser?.Name ?? "N/A")
                </dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">
                    @(Model.ApplicationUser?.Email ?? "N/A")
                </dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">
                    @(Model.ApplicationUser?.PhoneNumber ?? "N/A")
                </dd>

                <dt class="col-sm-3">Specialities</dt>
                <dd class="col-sm-9">

                    @if (Model.Specialities != null &&
                         Model.Specialities.Any())
                    {
                        foreach (var speciality in Model.Specialities)
                        {
                            <span class="badge bg-primary me-1 mb-1">
                                @speciality.Speciality
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">
                            No specialities listed
                        </span>
                    }

                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Availability</dt>
                <dd class="col-sm-9">

                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success">
                            Available
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Not Available
                        </span>
                    }

                </dd>

            </dl>

            <a asp-controller="ServiceManager"
               asp-action="Workers"
               class="btn btn-secondary">
                Back to Workers
            </a>

        </div>

    </div>

</div>
@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Worker Details";
}

<h2>Worker Details</h2>

<div class="card shadow-sm">
    <div class="card-body">

        ```
        <dl class="row">
            <dt class="col-sm-3">
                Worker ID
            </dt>

            <dd class="col-sm-9">
                @Model.Id
            </dd>

            <dt class="col-sm-3">
                Username
            </dt>

            <dd class="col-sm-9">
                @Model.User?.UserName
            </dd>

            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.User?.Email
            </dd>
        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
    </div>
    ```

</div>

@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "My Availability";
}

<div class="py-3">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Availability & Schedule</h2>
            <p class="text-muted small mb-0">Set your real-time dispatch status and configure weekly shift hours.</p>
        </div>

        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- REAL-TIME DISPATCH STATUS -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-toggle-on text-primary me-2"></i> Current Shift Status
            </h5>
        </div>
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="feature-icon-wrapper @(Model.IsAvailable ? "icon-success" : "icon-danger")" style="width:48px;height:48px;font-size:1.5rem;">
                    <i class="bi @(Model.IsAvailable ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-1">
                        @(Model.IsAvailable ? "Active & Ready for Tasks" : "Off-Duty / Away")
                    </h5>
                    <p class="text-muted small mb-0">
                        @(Model.IsAvailable ? "You are shown as active to service managers." : "Incoming tickets will not be allocated to you while unavailable.")
                    </p>
                </div>
            </div>

            <div>
                @if (Model.IsAvailable)
                {
                    <form asp-action="UpdateAvailability" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="isAvailable" value="false" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-pause-fill"></i> Go Off-Duty
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="UpdateAvailability" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="isAvailable" value="true" />
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-play-fill"></i> Go Active (Available)
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- WEEKLY SCHEDULE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-calendar-week text-primary me-2"></i> Weekly Working Schedule
            </h5>
        </div>
        <div class="card-body p-4">
            @if (Model.Availabilities.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Availabilities.OrderBy(x => x.WorkerAvailabilityId))
                    {
                        <form asp-action="UpdateWeeklyAvailability" method="post" class="p-3 bg-light rounded-3 border">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="availabilityId" value="@item.WorkerAvailabilityId" />

                            <div class="row align-items-center g-3">
                                <div class="col-md-2">
                                    <span class="fw-bold text-dark fs-6">
                                        <i class="bi bi-calendar-day text-primary me-1"></i> @item.DayOfWeek
                                    </span>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label small fw-semibold text-muted mb-1">Duty Status</label>
                                    <select name="isAvailable" class="form-select form-select-sm">
                                        <option value="true" selected="@(item.IsAvailable)">Working</option>
                                        <option value="false" selected="@(!item.IsAvailable)">Day Off</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold text-muted mb-1">Shift Start</label>
                                    <input type="time"
                                           name="startTime"
                                           class="form-control form-control-sm"
                                           value="@(item.StartTime.HasValue ? item.StartTime.Value.ToString(@"hh\:mm") : "")" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold text-muted mb-1">Shift End</label>
                                    <input type="time"
                                           name="endTime"
                                           class="form-control form-control-sm"
                                           value="@(item.EndTime.HasValue ? item.EndTime.Value.ToString(@"hh\:mm") : "")" />
                                </div>

                                <div class="col-md-2 text-md-end">
                                    <label class="form-label small d-none d-md-block">&nbsp;</label>
                                    <button type="submit" class="btn btn-primary btn-sm px-3 w-100 w-md-auto">
                                        <i class="bi bi-check-lg"></i> Update
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="text-center p-4">
                    <i class="bi bi-calendar-x text-muted fs-3"></i>
                    <p class="text-muted small mt-2 mb-0">No custom weekly hours recorded.</p>
                </div>
            }
        </div>
    </div>
</div>
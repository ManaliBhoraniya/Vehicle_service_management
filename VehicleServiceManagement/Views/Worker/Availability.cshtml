@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "My Availability";
}

<div class="container mt-4">

    <h2 class="mb-4">
        My Availability
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Current Status
            </h5>
        </div>

        <div class="card-body">

            @if (Model.IsAvailable)
            {
                <span class="badge bg-success fs-6">
                    Available for Work
                </span>

                <form asp-action="UpdateAvailability"
                      method="post"
                      class="mt-3">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="isAvailable"
                           value="false" />

                    <button type="submit"
                            class="btn btn-danger">
                        Mark Unavailable
                    </button>

                </form>
            }
            else
            {
                <span class="badge bg-danger fs-6">
                    Not Available
                </span>

                <form asp-action="UpdateAvailability"
                      method="post"
                      class="mt-3">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="isAvailable"
                           value="true" />

                    <button type="submit"
                            class="btn btn-success">
                        Mark Available
                    </button>

                </form>
            }

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Weekly Working Hours
            </h5>
        </div>

        <div class="card-body">

            @if (Model.Availabilities.Any())
            {
                @foreach (var item in Model.Availabilities
                    .OrderBy(x => x.WorkerAvailabilityId))
                {
                    <form asp-action="UpdateWeeklyAvailability"
                          method="post"
                          class="border rounded p-3 mb-3">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="availabilityId"
                               value="@item.WorkerAvailabilityId" />

                        <div class="row align-items-end">

                            <div class="col-md-2">

                                <strong>
                                    @item.DayOfWeek
                                </strong>

                            </div>

                            <div class="col-md-2">

                                <label class="form-label">
                                    Available
                                </label>

                                <select name="isAvailable"
                                        class="form-select">

                                    @if (item.IsAvailable)
                                    {
                                        <option value="true" selected>
                                            Yes
                                        </option>

                                        <option value="false">
                                            No
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="true">
                                            Yes
                                        </option>

                                        <option value="false" selected>
                                            No
                                        </option>
                                    }

                                </select>

                            </div>

                            <div class="col-md-3">

                                <label class="form-label">
                                    Start Time
                                </label>

                                <input type="time"
                                       name="startTime"
                                       class="form-control"
                                       value="@(item.StartTime.HasValue
                                                                           ? item.StartTime.Value.ToString(@"hh\:mm")
                                                                       : "")" />

                            </div>

                            <div class="col-md-3">

                                <label class="form-label">
                                    End Time
                                </label>

                                <input type="time"
                                       name="endTime"
                                       class="form-control"
                                       value="@(item.EndTime.HasValue
                                                                           ? item.EndTime.Value.ToString(@"hh\:mm")
                                                                       : "")" />

                            </div>

                            <div class="col-md-2">

                                <button type="submit"
                                        class="btn btn-primary">
                                    Save
                                </button>

                            </div>

                        </div>

                    </form>
                }
            }
            else
            {
                <div class="alert alert-info">
                    No availability schedule found.
                </div>
            }

        </div>

    </div>

</div>
@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Worker Registration";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h3 class="mb-0">Worker Registration</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-info">
                <strong>Workers register themselves.</strong>
                <br />
                Workers must create their own account, select their
                specialities, and upload their resume.
                The manager will then review and approve the account.
            </div>

            <p>
                Workers cannot be added manually from this page.
            </p>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-primary">
                Register Worker
            </a>

            <a asp-controller="ServiceManager"
               asp-action="Index"
               class="btn btn-secondary ms-2">
                Back to Manager Dashboard
            </a>

        </div>

    </div>

</div>
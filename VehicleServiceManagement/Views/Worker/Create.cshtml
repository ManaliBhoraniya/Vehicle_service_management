@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Worker Registration Info";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm text-center p-5">
            <div class="feature-icon-wrapper icon-primary mx-auto mb-3" style="width:64px;height:64px;font-size:2rem;">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Technicians Self-Register</h4>
            <p class="text-muted small mb-4">
                Technicians create their own accounts via the public portal, specify their mechanical specializations, and upload their credential resumes for administrative review.
            </p>

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-box-arrow-up-right"></i> Open Registration Form
                </a>
                <a asp-controller="ServiceManager" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
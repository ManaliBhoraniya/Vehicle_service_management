@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Add Worker";
}

<h2>Add Worker</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            ```
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UserId"
                       class="form-label">
                    User ID
                </label>

                <input asp-for="UserId"
                       class="form-control" />

                <span asp-validation-for="UserId"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Add Worker
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
    ```

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

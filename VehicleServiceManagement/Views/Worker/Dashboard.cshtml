@model VehicleServiceManagement.Models.Worker

@{
    ViewData["Title"] = "Worker Dashboard";

    var pending = Model.ServiceAssignments.Count(x => x.Status == "Pending");
    var accepted = Model.ServiceAssignments.Count(x => x.Status == "Accepted");
    var completed = Model.ServiceAssignments.Count(x => x.Status == "Completed");
    var rejected = Model.ServiceAssignments.Count(x => x.Status == "Rejected");
}

<div class="py-3">
    <!-- DASHBOARD HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge bg-warning text-warning-emphasis px-3 py-1 mb-1">
                <i class="bi bi-tools"></i> Technician Workspace
            </span>
            <h2 class="fw-bold mb-0">Welcome, @(Model.ApplicationUser?.Name ?? "Technician")</h2>
            <p class="text-muted small mb-0">Review assigned vehicle maintenance tickets, update shift availability, and log progress.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (Model.IsAvailable)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                    <span class="badge-dot" style="width:8px;height:8px;border-radius:50%;background:#10b981;display:inline-block;margin-right:6px;"></span> Available for Work
                </span>
            }
            else
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6">
                    <span class="badge-dot" style="width:8px;height:8px;border-radius:50%;background:#ef4444;display:inline-block;margin-right:6px;"></span> Currently Off-Duty
                </span>
            }
        </div>
    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- METRICS GRID -->
    <div class="row g-3 mb-4">
        <!-- PENDING -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label">Pending Response</span>
                    <div class="stat-icon icon-warning">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                </div>
                <div class="stat-value text-warning">@pending</div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-hourglass-split"></i> Awaiting your accept/reject
                </div>
            </div>
        </div>

        <!-- ACCEPTED / IN PROGRESS -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label">In Progress</span>
                    <div class="stat-icon icon-primary">
                        <i class="bi bi-gear-wide-connected"></i>
                    </div>
                </div>
                <div class="stat-value text-primary">@accepted</div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-activity"></i> Active vehicle repairs
                </div>
            </div>
        </div>

        <!-- COMPLETED -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label">Completed Jobs</span>
                    <div class="stat-icon icon-success">
                        <i class="bi bi-check2-all"></i>
                    </div>
                </div>
                <div class="stat-value text-success">@completed</div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-patch-check"></i> Quality verified
                </div>
            </div>
        </div>

        <!-- REJECTED -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label">Declined</span>
                    <div class="stat-icon icon-danger">
                        <i class="bi bi-x-octagon-fill"></i>
                    </div>
                </div>
                <div class="stat-value text-secondary">@rejected</div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-dash-circle"></i> Reallocated tickets
                </div>
            </div>
        </div>
    </div>

    <!-- PROFILE & SPECIALTIES -->
    <div class="row g-4 mb-4">
        <!-- TECHNICIAN PROFILE SUMMARY -->
        <div class="col-lg-7">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-workspace text-primary me-2"></i> Technician Credentials
                    </h5>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">View</a>
                        <a asp-action="Edit" class="btn btn-sm btn-outline-primary">Edit</a>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Full Name</span>
                            <span class="fw-bold text-dark fs-6">@(Model.ApplicationUser?.Name ?? "-")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Email Address</span>
                            <span class="fw-semibold text-dark">@(Model.ApplicationUser?.Email ?? "-")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">Phone Number</span>
                            <span class="fw-semibold text-dark">@(Model.ApplicationUser?.PhoneNumber ?? "Not provided")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted small d-block">System Username</span>
                            <span class="fw-semibold text-dark">@(Model.ApplicationUser?.UserName ?? "-")</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <span class="fw-semibold text-dark d-block mb-2">Certified Specialties:</span>
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.Specialities != null && Model.Specialities.Any())
                            {
                                foreach (var speciality in Model.Specialities)
                                {
                                    <span class="badge bg-primary text-primary-emphasis px-3 py-2">
                                        <i class="bi bi-patch-check-fill me-1"></i> @speciality.Speciality
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">No specialities linked yet.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- AVAILABILITY & SHIFT STATUS -->
        <div class="col-lg-5">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history text-primary me-2"></i> Duty & Shift Status
                    </h5>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 p-3 rounded-3 @(Model.IsAvailable ? "bg-success-subtle border border-success-subtle" : "bg-danger-subtle border border-danger-subtle") mb-3">
                            <i class="bi @(Model.IsAvailable ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") fs-3"></i>
                            <div>
                                <span class="fw-bold text-dark d-block">@(Model.IsAvailable ? "Available for Dispatch" : "Marked As Unavailable")</span>
                                <span class="text-muted small">@(Model.IsAvailable ? "Managers can route incoming maintenance tickets to you." : "Managers will skip routing new requests to your queue.")</span>
                            </div>
                        </div>

                        <form asp-action="UpdateAvailability" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="isAvailable" value="@(Model.IsAvailable ? "false" : "true")" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                            @if (Model.IsAvailable)
                            {
                                <button class="btn btn-outline-danger w-100 py-2" type="submit">
                                    <i class="bi bi-pause-circle"></i> Pause / Mark Unavailable
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success w-100 py-2" type="submit">
                                    <i class="bi bi-play-circle"></i> Resume / Mark Available
                                </button>
                            }
                        </form>
                    </div>

                    <a asp-action="Availability" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="bi bi-calendar-week"></i> Manage Detailed Weekly Schedule
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- RESUME & RECENT ASSIGNMENTS -->
    <div class="row g-4 mb-4">
        <!-- RESUME CARD -->
        <div class="col-lg-5">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-file-earmark-pdf text-primary me-2"></i> Resume & Certifications
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.ResumeFilePath))
                    {
                        <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between mb-3 border">
                            <div class="d-flex align-items-center gap-2 text-truncate">
                                <i class="bi bi-file-earmark-check-fill text-primary fs-4"></i>
                                <span class="fw-semibold text-dark text-truncate">@Model.ResumeFileName</span>
                            </div>
                            <a href="@Model.ResumeFilePath" target="_blank" class="btn btn-sm btn-outline-primary flex-shrink-0">
                                <i class="bi bi-download"></i> View
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">No certificate or resume uploaded yet.</p>
                    }

                    <form asp-action="UploadResume" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <label class="form-label small fw-semibold text-muted">Upload Updated Document</label>
                        <div class="input-group">
                            <input type="file" name="resume" class="form-control form-control-sm" accept=".pdf,.doc,.docx" required />
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-upload"></i> Upload
                            </button>
                        </div>
                        <div class="form-text text-muted small">PDF, DOC or DOCX (Max 5 MB).</div>
                    </form>
                </div>
            </div>
        </div>

        <!-- RECENT WORK ASSIGNMENTS -->
        <div class="col-lg-7">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clipboard-data text-primary me-2"></i> Recent Work Assignments
                    </h5>
                    <a asp-action="MyServices" class="btn btn-primary btn-sm">
                        View All Work <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.ServiceAssignments.Any())
                    {
                        <div class="table-responsive border-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Service Task</th>
                                        <th>Assigned Date</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assignment in Model.ServiceAssignments.OrderByDescending(x => x.AssignedDate).Take(5))
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">
                                                <i class="bi bi-tools text-muted me-1"></i> @(assignment.ServiceRequest?.ServiceType ?? "Service")
                                            </td>
                                            <td class="text-muted small">
                                                @assignment.AssignedDate.ToString("dd MMM yyyy")
                                            </td>
                                            <td class="text-end">
                                                @if (assignment.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-warning-emphasis">Pending</span>
                                                }
                                                else if (assignment.Status == "Accepted")
                                                {
                                                    <span class="badge bg-primary text-primary-emphasis">In Progress</span>
                                                }
                                                else if (assignment.Status == "Completed")
                                                {
                                                    <span class="badge bg-success text-success-emphasis">Completed</span>
                                                }
                                                else if (assignment.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger text-danger-emphasis">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@assignment.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4">
                            <i class="bi bi-clipboard-check text-muted fs-2"></i>
                            <p class="text-muted small mt-2 mb-0">No active assignments assigned to your queue.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
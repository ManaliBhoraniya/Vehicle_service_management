@model VehicleServiceManagement.Models.Customer

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="brand-icon" style="width: 32px; height: 32px; font-size: 1rem;">
                        <i class="bi bi-pencil-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Edit Profile</h4>
                        <p class="text-muted small mb-0">Update your contact information and service address</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-person me-1 text-muted"></i> Full Name
                        </label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">
                            <i class="bi bi-telephone me-1 text-muted"></i> Phone Number
                        </label>
                        <input asp-for="Phone" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label">
                            <i class="bi bi-geo-alt me-1 text-muted"></i> Full Address
                        </label>
                        <textarea asp-for="Address" class="form-control" rows="3" required></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
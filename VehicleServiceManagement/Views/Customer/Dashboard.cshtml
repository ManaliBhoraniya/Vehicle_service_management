@model VehicleServiceManagement.Models.Customer?

@{
    ViewData["Title"] = "Customer Dashboard";

    var customerName = ViewBag.CustomerName as string ?? "Customer";
    int vehicleCount = ViewBag.VehicleCount ?? 0;
    int totalRequests = ViewBag.TotalRequests ?? 0;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int inProgressCount = ViewBag.InProgressCount ?? 0;
    int completedCount = ViewBag.CompletedCount ?? 0;
}

<div class="py-3">
    <!-- DASHBOARD HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge bg-primary text-primary-emphasis px-3 py-1 mb-1">
                <i class="bi bi-person-fill"></i> Customer Portal
            </span>
            <h2 class="fw-bold mb-0">Welcome, @customerName</h2>
            <p class="text-muted small mb-0">Manage your garage, track ongoing repairs, and book new services.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Vehicle" asp-action="Create" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Add Vehicle
            </a>
            @if (vehicleCount > 0)
            {
                <a asp-controller="ServiceRequest" asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                    <i class="bi bi-clipboard-plus"></i> Request Service
                </a>
            }
        </div>
    </div>

    <!-- SUCCESS NOTIFICATION -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- PROFILE COMPLETION ALERT -->
    @if (Model == null)
    {
        <div class="card border-warning mb-4 shadow-sm" style="background-color: #fffbeb;">
            <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="feature-icon-wrapper icon-warning flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.3rem;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Complete Your Customer Profile</h5>
                        <p class="text-muted small mb-0">
                            Your account is active, but your profile information is pending. Please complete your profile to register vehicles and schedule appointments.
                        </p>
                    </div>
                </div>
                <a asp-controller="Customer" asp-action="Create" class="btn btn-warning flex-shrink-0">
                    <i class="bi bi-pencil-square"></i> Complete Profile Now
                </a>
            </div>
        </div>
    }

    <!-- METRICS / STATS CARDS -->
    <div class="row g-3 mb-4">
        <!-- VEHICLES -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label">Registered Vehicles</span>
                    <div class="stat-icon icon-primary">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                </div>
                <div class="stat-value text-primary">@vehicleCount</div>
                <a asp-controller="Vehicle" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2 w-100">
                    View Fleet <i class="bi bi-chevron-right ms-auto"></i>
                </a>
            </div>
        </div>

        <!-- TOTAL REQUESTS -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label">Total Services</span>
                    <div class="stat-icon icon-info">
                        <i class="bi bi-calendar2-check-fill"></i>
                    </div>
                </div>
                <div class="stat-value text-info">@totalRequests</div>
                <a asp-controller="ServiceRequest" asp-action="Index" class="btn btn-sm btn-outline-info mt-2 w-100">
                    Service History <i class="bi bi-chevron-right ms-auto"></i>
                </a>
            </div>
        </div>

        <!-- PENDING -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label">Awaiting Assignment</span>
                    <div class="stat-icon icon-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <div class="stat-value text-warning">@pendingCount</div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-info-circle"></i> In queue with manager
                </div>
            </div>
        </div>

        <!-- COMPLETED -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label">Completed Services</span>
                    <div class="stat-icon icon-success">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
                <div class="stat-value text-success">@completedCount</div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-shield-check text-success"></i> Fully inspected
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS & STATUS BREAKDOWN -->
    <div class="row g-4 mb-4">
        <!-- SERVICE STATUS TRACKER -->
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-activity text-primary me-2"></i> Service Pipeline
                    </h5>
                    <a asp-controller="ServiceRequest" asp-action="Index" class="small text-primary fw-semibold">
                        View All <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-around">
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light mb-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge-dot" style="width:10px; height:10px; border-radius:50%; background-color:#f59e0b;"></span>
                            <div>
                                <span class="fw-semibold text-dark d-block">Pending Review</span>
                                <span class="text-muted small">Submitted and waiting for specialist allocation</span>
                            </div>
                        </div>
                        <span class="badge bg-warning text-warning-emphasis fs-6 px-3">@pendingCount</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light mb-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge-dot" style="width:10px; height:10px; border-radius:50%; background-color:#2563eb;"></span>
                            <div>
                                <span class="fw-semibold text-dark d-block">Assigned & In Progress</span>
                                <span class="text-muted small">Specialist currently actively performing diagnostics/service</span>
                            </div>
                        </div>
                        <span class="badge bg-primary text-primary-emphasis fs-6 px-3">@inProgressCount</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge-dot" style="width:10px; height:10px; border-radius:50%; background-color:#10b981;"></span>
                            <div>
                                <span class="fw-semibold text-dark d-block">Finished & Ready</span>
                                <span class="text-muted small">Service completed and verified</span>
                            </div>
                        </div>
                        <span class="badge bg-success text-success-emphasis fs-6 px-3">@completedCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS HUB -->
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-grid-fill text-primary me-2"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <a asp-controller="Vehicle" asp-action="Create" class="quick-action-card">
                                <div class="action-icon icon-success">
                                    <i class="bi bi-plus-circle"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">Add Vehicle</div>
                                    <div class="text-muted small">Register a new car</div>
                                </div>
                            </a>
                        </div>

                        <div class="col-sm-6">
                            <a asp-controller="ServiceRequest" asp-action="Create" class="quick-action-card">
                                <div class="action-icon icon-warning">
                                    <i class="bi bi-tools"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">Request Service</div>
                                    <div class="text-muted small">Book repair or checkup</div>
                                </div>
                            </a>
                        </div>

                        <div class="col-sm-6">
                            <a asp-controller="Vehicle" asp-action="Index" class="quick-action-card">
                                <div class="action-icon icon-primary">
                                    <i class="bi bi-car-front"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">My Vehicles</div>
                                    <div class="text-muted small">Manage fleet details</div>
                                </div>
                            </a>
                        </div>

                        <div class="col-sm-6">
                            <a asp-controller="Customer" asp-action="Index" class="quick-action-card">
                                <div class="action-icon icon-info">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">My Profile</div>
                                    <div class="text-muted small">Contact & address</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PROFILE INFO & VEHICLES -->
    @if (Model != null)
    {
        <div class="row g-4 mb-4">
            <!-- PROFILE DETAILS -->
            <div class="col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i> Profile
                        </h5>
                        <a asp-controller="Customer" asp-action="Edit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="text-muted small d-block">Full Name</span>
                            <span class="fw-bold text-dark fs-6">@Model.Name</span>
                        </div>
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="text-muted small d-block">Email Address</span>
                            <span class="fw-semibold text-dark">@(Model.ApplicationUser?.Email ?? "-")</span>
                        </div>
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="text-muted small d-block">Phone Number</span>
                            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Billing / Contact Address</span>
                            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MY VEHICLES TABLE -->
            <div class="col-lg-8">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-car-front-fill text-primary me-2"></i> Registered Vehicles
                        </h5>
                        <a asp-controller="Vehicle" asp-action="Create" class="btn btn-success btn-sm">
                            <i class="bi bi-plus-lg"></i> Add Vehicle
                        </a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Vehicles != null && Model.Vehicles.Any())
                        {
                            <div class="table-responsive border-0">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Vehicle Number</th>
                                            <th>Model & Make</th>
                                            <th>Type</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var vehicle in Model.Vehicles)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">
                                                    <i class="bi bi-car-front text-muted me-1"></i> @vehicle.VehicleNumber
                                                </td>
                                                <td>@vehicle.VehicleModel</td>
                                                <td>
                                                    <span class="badge bg-secondary">@vehicle.VehicleType</span>
                                                </td>
                                                <td class="text-end">
                                                    <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-info">
                                                        Details
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center p-5">
                                <i class="bi bi-car-front text-muted" style="font-size: 3rem;"></i>
                                <h6 class="fw-bold text-dark mt-3">No Vehicles Added Yet</h6>
                                <p class="text-muted small mb-3">Add your first vehicle to schedule maintenance and repairs.</p>
                                <a asp-controller="Vehicle" asp-action="Create" class="btn btn-primary btn-sm">
                                    <i class="bi bi-plus-lg"></i> Add Vehicle
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- SERVICE PROMOTION / SCHEDULE CALLOUT -->
        <div class="card border-0 shadow-sm p-4 text-center mt-2" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);">
            <h4 class="fw-bold text-dark mb-1">Time for Routine Maintenance or Diagnostics?</h4>
            <p class="text-muted small mb-3">Book certified automotive technicians to keep your vehicle performing at its peak.</p>
            <div>
                @if (vehicleCount > 0)
                {
                    <a asp-controller="ServiceRequest" asp-action="Create" class="btn btn-success px-4">
                        <i class="bi bi-clipboard-plus me-1"></i> Schedule Service Ticket
                    </a>
                }
                else
                {
                    <a asp-controller="Vehicle" asp-action="Create" class="btn btn-primary px-4">
                        <i class="bi bi-plus-circle me-1"></i> Add Vehicle First
                    </a>
                }
            </div>
        </div>
    }
</div>
@model VehicleServiceManagement.Models.Customer

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Profile</h2>

        <a asp-action="Edit"
           class="btn btn-primary">
            Edit Profile
        </a>
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">
                    Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @Model.ApplicationUser?.Email
                </dd>

                <dt class="col-sm-3">
                    Phone
                </dt>

                <dd class="col-sm-9">
                    @Model.Phone
                </dd>

                <dt class="col-sm-3">
                    Address
                </dt>

                <dd class="col-sm-9">
                    @Model.Address
                </dd>

            </dl>

        </div>

    </div>

    <div class="d-flex gap-3">

        <a asp-controller="Vehicle"
           asp-action="Index"
           class="btn btn-outline-primary">
            My Vehicles
        </a>

        <a asp-controller="ServiceRequest"
           asp-action="Index"
           class="btn btn-outline-success">
            My Service Requests
        </a>

    </div>

</div>
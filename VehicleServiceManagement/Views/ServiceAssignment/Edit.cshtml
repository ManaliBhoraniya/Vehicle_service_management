@model VehicleServiceManagement.Models.ServiceAssignment

@{
    ViewData["Title"] = "Edit Service Assignment";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>
                Edit Service Assignment
            </h2>

            <p class="text-muted mb-0">
                Update the assignment information.
            </p>

        </div>

        <a asp-controller="ServiceManager"
           asp-action="Assignments"
           class="btn btn-outline-secondary">
            Back to Assignments
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                Assignment Information
            </h5>

        </div>


        <div class="card-body">

            <form asp-controller="ServiceAssignment"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="ServiceAssignmentId" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- SERVICE REQUEST -->

                <div class="mb-3">

                    <label asp-for="ServiceRequestId"
                           class="form-label">
                        Service Request
                    </label>

                    <select asp-for="ServiceRequestId"
                            class="form-select"
                            asp-items="ViewBag.ServiceRequestId">

                        <option value="">
                            -- Select Service Request --
                        </option>

                    </select>

                    <span asp-validation-for="ServiceRequestId"
                          class="text-danger">
                    </span>

                </div>


                <!-- WORKER -->

                <div class="mb-3">

                    <label asp-for="WorkerId"
                           class="form-label">
                        Worker
                    </label>

                    <select asp-for="WorkerId"
                            class="form-select"
                            asp-items="ViewBag.WorkerId">

                        <option value="">
                            -- Select Worker --
                        </option>

                    </select>

                    <span asp-validation-for="WorkerId"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Select an accepted and available worker
                        with the required speciality.
                    </div>

                </div>


                <!-- STATUS -->

                <div class="mb-3">

                    <label asp-for="Status"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="Accepted">
                            Accepted
                        </option>

                        <option value="Rejected">
                            Rejected
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                </div>


                <!-- ASSIGNED DATE -->

                <div class="mb-3">

                    <label asp-for="AssignedDate"
                           class="form-label">
                        Assigned Date
                    </label>

                    <input asp-for="AssignedDate"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="AssignedDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- COMPLETED DATE -->

                <div class="mb-3">

                    <label asp-for="CompletedDate"
                           class="form-label">
                        Completed Date
                    </label>

                    <input asp-for="CompletedDate"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="CompletedDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- NOTES -->

                <div class="mb-3">

                    <label asp-for="Notes"
                           class="form-label">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="4"
                              placeholder="Optional notes">
                    </textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="ServiceManager"
                       asp-action="Assignments"
                       class="btn btn-secondary ms-2">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}
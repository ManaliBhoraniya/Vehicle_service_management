@model VehicleServiceManagement.Models.ServiceAssignment

@{
    ViewData["Title"] = "Edit Service Assignment";

    var workers =
        ViewBag.Workers as List<VehicleServiceManagement.Models.Worker>
        ?? new List<VehicleServiceManagement.Models.Worker>();

    var serviceRequests =
        ViewBag.ServiceRequests as List<VehicleServiceManagement.Models.ServiceRequest>
        ?? new List<VehicleServiceManagement.Models.ServiceRequest>();
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h3>Edit Service Assignment</h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  asp-route-id="@Model.ServiceAssignmentId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="ServiceAssignmentId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Service Request -->

                <div class="mb-3">

                    <label asp-for="ServiceRequestId"
                           class="form-label">
                        Service Request
                    </label>

                    <select asp-for="ServiceRequestId"
                            class="form-select">

                        @foreach (var request in serviceRequests)
                        {
                            <option value="@request.ServiceRequestId">

                                #@request.ServiceRequestId
                                -
                                @request.ServiceType

                                @if (!string.IsNullOrWhiteSpace(request.CustomerName))
                                {
                                    <text>
                                        - @request.CustomerName
                                    </text>
                                }

                            </option>
                        }

                    </select>

                    <span asp-validation-for="ServiceRequestId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Worker -->

                <div class="mb-3">

                    <label asp-for="WorkerId"
                           class="form-label">
                        Worker
                    </label>

                    <select asp-for="WorkerId"
                            class="form-select">

                        @foreach (var worker in workers)
                        {
                            <option value="@worker.WorkerId">

                                @if (worker.ApplicationUser != null)
                                {
                                    @worker.ApplicationUser.Name
                                }
                                else
                                {
                                    @worker.Profession
                                }

                                - @worker.Profession

                            </option>
                        }

                    </select>

                    <span asp-validation-for="WorkerId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Status -->

                <div class="mb-3">

                    <label asp-for="Status"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="In Progress">
                            In Progress
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                        <option value="Cancelled">
                            Cancelled
                        </option>

                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                </div>


                <!-- Notes -->

                <div class="mb-3">

                    <label asp-for="Notes"
                           class="form-label">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
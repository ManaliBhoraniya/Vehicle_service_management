@model IEnumerable<VehicleServiceManagement.Models.ServiceAssignment>

@{
    ViewData["Title"] = "Service Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Service Assignments</h2>

    <a asp-action="Create"
       class="btn btn-success">
        Create Assignment
    </a>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No service assignments found.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-bordered table-hover">

            <thead class="table-dark">

                <tr>
                    <th>Assignment ID</th>
                    <th>Service Request</th>
                    <th>Vehicle</th>
                    <th>Worker</th>
                    <th>Service Date</th>
                    <th>Service Time</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var assignment in Model)
                {
                    <tr>

                        <td>
                            @assignment.Id
                        </td>

                        <td>
                            #@assignment.ServiceRequestId
                        </td>

                        <td>
                            @assignment.ServiceRequest?.Vehicle?.VehicleNumber
                        </td>

                        <td>
                            @assignment.Worker?.ApplicationUser?.Name
                        </td>

                        <td>
                            @assignment.ServiceDate.ToString("dd-MM-yyyy")
                        </td>

                        <td>
                            @assignment.ServiceTime.ToString(@"hh\:mm")
                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@assignment.Id"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@assignment.Id"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@assignment.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this assignment?');">
                                    Delete
                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}
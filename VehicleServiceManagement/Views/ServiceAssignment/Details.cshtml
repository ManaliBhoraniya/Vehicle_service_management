@model VehicleServiceManagement.Models.ServiceAssignment

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h3>Service Assignment Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-4">
                    Assignment ID
                </dt>

                <dd class="col-sm-8">
                    @Model.ServiceAssignmentId
                </dd>


                <dt class="col-sm-4">
                    Service Request
                </dt>

                <dd class="col-sm-8">

                    @if (Model.ServiceRequest != null)
                    {
                        <span>
                            #@Model.ServiceRequest.ServiceRequestId
                            -
                            @Model.ServiceRequest.ServiceType
                        </span>
                    }
                    else
                    {
                        <span>Not available</span>
                    }

                </dd>


                <dt class="col-sm-4">
                    Customer
                </dt>

                <dd class="col-sm-8">

                    @if (Model.ServiceRequest != null)
                    {
                        @Model.ServiceRequest.CustomerName
                    }
                    else
                    {
                        <span>Not available</span>
                    }

                </dd>


                <dt class="col-sm-4">
                    Worker
                </dt>

                <dd class="col-sm-8">

                    @if (Model.Worker?.ApplicationUser != null)
                    {
                        @Model.Worker.ApplicationUser.Name
                    }
                    else if (Model.Worker != null)
                    {
                        @Model.Worker.Profession
                    }
                    else
                    {
                        <span>Not available</span>
                    }

                </dd>


                <dt class="col-sm-4">
                    Profession
                </dt>

                <dd class="col-sm-8">

                    @Model.Worker?.Profession

                </dd>


                <dt class="col-sm-4">
                    Status
                </dt>

                <dd class="col-sm-8">

                    <span class="badge bg-primary">
                        @Model.Status
                    </span>

                </dd>


                <dt class="col-sm-4">
                    Assigned Date
                </dt>

                <dd class="col-sm-8">

                    @Model.AssignedDate.ToString("dd/MM/yyyy hh:mm tt")

                </dd>


                <dt class="col-sm-4">
                    Completed Date
                </dt>

                <dd class="col-sm-8">

                    @if (Model.CompletedDate.HasValue)
                    {
                        @Model.CompletedDate.Value.ToString(
                            "dd/MM/yyyy hh:mm tt")
                    }
                    else
                    {
                        <span>Not completed</span>
                    }

                </dd>


                <dt class="col-sm-4">
                    Notes
                </dt>

                <dd class="col-sm-8">

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        @Model.Notes
                    }
                    else
                    {
                        <span>No notes</span>
                    }

                </dd>

            </dl>


            <div class="mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.ServiceAssignmentId"
                   class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </div>

        </div>

    </div>

</div>
@model VehicleServiceManagement.Models.ServiceAssignment

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Assignment Details</h2>

            <p class="text-muted mb-0">
                View service assignment information.
            </p>
        </div>

        <a asp-controller="ServiceManager"
           asp-action="Assignments"
           class="btn btn-outline-secondary">
            Back to Assignments
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Service Assignment
            </h5>
        </div>


        <div class="card-body">

            <dl class="row">

                <!-- ASSIGNMENT ID -->

                <dt class="col-sm-4">
                    Assignment ID
                </dt>

                <dd class="col-sm-8">
                    @Model.ServiceAssignmentId
                </dd>


                <!-- SERVICE REQUEST -->

                <dt class="col-sm-4">
                    Service Request
                </dt>

                <dd class="col-sm-8">

                    @if (Model.ServiceRequest != null)
                    {
                        <span>
                            #@Model.ServiceRequestId
                        </span>

                        <span class="ms-2">
                            @Model.ServiceRequest.ServiceType
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            No service request information
                        </span>
                    }

                </dd>


                <!-- WORKER -->

                <dt class="col-sm-4">
                    Worker
                </dt>

                <dd class="col-sm-8">

                    @if (Model.Worker != null)
                    {
                        <div>
                            <strong>
                                @(Model.Worker.ApplicationUser?.Name ?? "Worker")
                            </strong>
                        </div>

                        <div class="mt-2">

                            @if (Model.Worker.Specialities != null &&
                                 Model.Worker.Specialities.Any())
                            {
                                foreach (var speciality in Model.Worker.Specialities)
                                {
                                    <span class="badge bg-primary me-1 mb-1">
                                        @speciality.Speciality
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    No specialities listed
                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <span class="text-muted">
                            No worker assigned
                        </span>
                    }

                </dd>


                <!-- STATUS -->

                <dt class="col-sm-4">
                    Status
                </dt>

                <dd class="col-sm-8">

                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (Model.Status == "Accepted")
                    {
                        <span class="badge bg-primary">
                            Accepted
                        </span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <span class="badge bg-danger">
                            Rejected
                        </span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="badge bg-success">
                            Completed
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }

                </dd>


                <!-- ASSIGNED DATE -->

                <dt class="col-sm-4">
                    Assigned Date
                </dt>

                <dd class="col-sm-8">
                    @Model.AssignedDate.ToString("dd-MM-yyyy hh:mm tt")
                </dd>


                <!-- COMPLETED DATE -->

                <dt class="col-sm-4">
                    Completed Date
                </dt>

                <dd class="col-sm-8">

                    @if (Model.CompletedDate.HasValue)
                    {
                        <span>
                            @Model.CompletedDate.Value.ToString("dd-MM-yyyy hh:mm tt")
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            Not completed
                        </span>
                    }

                </dd>


                <!-- NOTES -->

                <dt class="col-sm-4">
                    Notes
                </dt>

                <dd class="col-sm-8">

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <span>
                            @Model.Notes
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            No notes
                        </span>
                    }

                </dd>

            </dl>


            <div class="mt-4">

                <a asp-controller="ServiceAssignment"
                   asp-action="Edit"
                   asp-route-id="@Model.ServiceAssignmentId"
                   class="btn btn-primary">
                    Edit
                </a>

                <a asp-controller="ServiceManager"
                   asp-action="Assignments"
                   class="btn btn-secondary ms-2">
                    Back
                </a>

            </div>

        </div>

    </div>

</div>
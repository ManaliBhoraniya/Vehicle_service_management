@model VehicleServiceManagement.Models.ServiceAssignment

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="brand-icon" style="width: 36px; height: 36px; font-size: 1.1rem;">
                        <i class="bi bi-kanban"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Service Assignment #@Model.ServiceAssignmentId</h5>
                        <span class="text-muted small">Assigned on @Model.AssignedDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                    </div>
                </div>

                <div>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-warning-emphasis px-3 py-2">
                            <i class="bi bi-hourglass-split"></i> Pending Confirmation
                        </span>
                    }
                    else if (Model.Status == "Accepted")
                    {
                        <span class="badge bg-primary text-primary-emphasis px-3 py-2">
                            <i class="bi bi-person-gear"></i> In Progress
                        </span>
                    }
                    else if (Model.Status == "Completed")
                    {
                        <span class="badge bg-success text-success-emphasis px-3 py-2">
                            <i class="bi bi-check2-circle"></i> Completed
                        </span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <span class="badge bg-danger text-danger-emphasis px-3 py-2">
                            <i class="bi bi-x-circle"></i> Rejected
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2">@Model.Status</span>
                    }
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">
                    <!-- TICKET LINK -->
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Service Request Ticket</label>
                        @if (Model.ServiceRequest != null)
                        {
                            <span class="fs-6 fw-bold text-dark">
                                #@Model.ServiceRequestId - @Model.ServiceRequest.ServiceType
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No service request data</span>
                        }
                    </div>

                    <!-- WORKER -->
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Assigned Technician</label>
                        @if (Model.Worker != null)
                        {
                            <span class="fs-6 fw-bold text-dark">
                                @(Model.Worker.ApplicationUser?.Name ?? "Worker #" + Model.WorkerId)
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">No worker assigned</span>
                        }
                    </div>

                    <!-- TIMESTAMPS -->
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Assigned Date & Time</label>
                        <span class="fw-semibold text-dark">
                            <i class="bi bi-calendar-event me-1 text-muted"></i> @Model.AssignedDate.ToString("dd MMM yyyy, hh:mm tt")
                        </span>
                    </div>

                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Completed Date & Time</label>
                        @if (Model.CompletedDate.HasValue)
                        {
                            <span class="fw-semibold text-success">
                                <i class="bi bi-calendar-check me-1 text-success"></i> @Model.CompletedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small">Not completed yet</span>
                        }
                    </div>

                    <!-- NOTES -->
                    <div class="col-12">
                        <label class="text-muted small d-block">Dispatch Notes & Special Instructions</label>
                        <div class="p-3 bg-light rounded-3 text-dark mt-1">
                            @(string.IsNullOrWhiteSpace(Model.Notes) ? "No special instructions provided." : Model.Notes)
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4 pt-3 border-top">
                    <a asp-controller="ServiceAssignment" asp-action="Edit" asp-route-id="@Model.ServiceAssignmentId" class="btn btn-primary btn-sm">
                        <i class="bi bi-pencil"></i> Edit Assignment
                    </a>
                    <a asp-controller="ServiceManager" asp-action="Assignments" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to Assignments
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
@model VehicleServiceManagement.Models.ServiceAssignment

@{
    ViewData["Title"] = "Create Service Assignment";

    var serviceRequests =
        ViewBag.ServiceRequests as IEnumerable<VehicleServiceManagement.Models.ServiceRequest>;

    var workers =
        ViewBag.Workers as IEnumerable<VehicleServiceManagement.Models.Worker>;
}

<h2>Create Service Assignment</h2>

<div class="row">
    <div class="col-md-7">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Service Request -->
            <div class="mb-3">
                <label asp-for="ServiceRequestId"
                       class="form-label">
                    Service Request
                </label>

                <select asp-for="ServiceRequestId"
                        class="form-select">

                    <option value="">
                        -- Select Service Request --
                    </option>

                    @if (serviceRequests != null)
                    {
                        foreach (var request in serviceRequests)
                        {
                            <option value="@request.Id">
                                Request #@request.Id -
                                @request.Vehicle?.VehicleNumber
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="ServiceRequestId"
                      class="text-danger">
                </span>
            </div>

            <!-- Worker -->
            <div class="mb-3">
                <label asp-for="WorkerId"
                       class="form-label">
                    Worker
                </label>

                <select asp-for="WorkerId"
                        class="form-select">

                    <option value="">
                        -- Select Worker --
                    </option>

                    @if (workers != null)
                    {
                        foreach (var worker in workers)
                        {
                            <option value="@worker.Id">
                                @worker.ApplicationUser?.Name
                                -
                                @worker.Profession
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="WorkerId"
                      class="text-danger">
                </span>
            </div>

            <!-- Service Date -->
            <div class="mb-3">
                <label asp-for="ServiceDate"
                       class="form-label">
                    Service Date
                </label>

                <input asp-for="ServiceDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="ServiceDate"
                      class="text-danger">
                </span>
            </div>

            <!-- Service Time -->
            <div class="mb-3">
                <label asp-for="ServiceTime"
                       class="form-label">
                    Service Time
                </label>

                <input asp-for="ServiceTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="ServiceTime"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Create Assignment
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model VehicleServiceManagement.Models.ServiceAssignment

@{
    ViewData["Title"] = "Create Service Assignment";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="brand-icon" style="width: 34px; height: 34px; font-size: 1rem;">
                        <i class="bi bi-kanban-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Create Service Assignment</h4>
                        <p class="text-muted small mb-0">Assign a pending service ticket to a qualified technician</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-controller="ServiceAssignment" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <!-- SERVICE REQUEST -->
                    <div class="mb-3">
                        <label asp-for="ServiceRequestId" class="form-label">
                            <i class="bi bi-ticket-detailed me-1 text-muted"></i> Service Request Ticket
                        </label>
                        <select asp-for="ServiceRequestId" class="form-select" asp-items="ViewBag.ServiceRequestId" required>
                            <option value="">-- Select Service Request --</option>
                        </select>
                        <span asp-validation-for="ServiceRequestId" class="text-danger small"></span>
                    </div>

                    <!-- WORKER -->
                    <div class="mb-3">
                        <label asp-for="WorkerId" class="form-label">
                            <i class="bi bi-person me-1 text-muted"></i> Assigned Technician
                        </label>
                        <select asp-for="WorkerId" class="form-select" asp-items="ViewBag.WorkerId" required>
                            <option value="">-- Select Worker --</option>
                        </select>
                        <span asp-validation-for="WorkerId" class="text-danger small"></span>
                        <div class="form-text text-muted small">Choose an available technician with matching specialty.</div>
                    </div>

                    <!-- STATUS -->
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">
                            <i class="bi bi-tag me-1 text-muted"></i> Initial Assignment Status
                        </label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending (Awaiting Worker Confirmation)</option>
                            <option value="Accepted">Accepted / In Progress</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Completed">Completed</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <!-- ASSIGNED DATE -->
                    <div class="mb-3">
                        <label asp-for="AssignedDate" class="form-label">
                            <i class="bi bi-calendar-event me-1 text-muted"></i> Assignment Timestamp
                        </label>
                        <input asp-for="AssignedDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="AssignedDate" class="text-danger small"></span>
                    </div>

                    <!-- NOTES -->
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">
                            <i class="bi bi-chat-text me-1 text-muted"></i> Instructions / Dispatch Notes
                        </label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Provide any special instructions or technician notes..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg"></i> Create Assignment
                        </button>
                        <a asp-controller="ServiceManager" asp-action="Assignments" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
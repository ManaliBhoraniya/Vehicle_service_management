@model ErrorViewModel
@{
    ViewData["Title"] = "Application Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg text-center p-5">
            <div class="feature-icon-wrapper icon-danger mx-auto mb-4" style="width: 72px; height: 72px; font-size: 2.2rem; border-radius: 50%;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <h2 class="fw-bold text-dark mb-2">Something Went Wrong</h2>
            <p class="text-muted mb-4">An unexpected error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <div class="p-3 bg-light rounded-3 small mb-4 border">
                    <span class="text-muted">Request Tracking ID:</span>
                    <code class="fw-bold text-danger">@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>
